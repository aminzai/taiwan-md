---
/**
 * RankBars — 排序橫條（今年值）＋ 起點年幽靈標記（dumbbell）＋ 增減標籤。
 * 一列一機關；`highlight` 的列上色，其餘退灰當脈絡（graph.md §三.10）。
 * v2：寬 760／窄 400 兩套幾何；圖例依第一項估寬動態排；`shareOf` 給資料表加占比欄；
 * `unit="%"` 時值本身是百分比（例：四大支出十年成長率），不畫起點標記。
 */
import { scaleLinear, niceTicks, fmtAxis, fmtYi, fmtPct, estTextW, CHART_WIDTHS } from '../../utils/budgetViz';

export interface Row {
  id: string;
  label: string;
  /** 今年值（億元；unit='%' 時為百分比） */
  now: number;
  /** 起點年值（億元），可 null */
  then?: number | null;
  highlight?: boolean;
  /** 額外小字（例：主管機關改制註記） */
  note?: string;
}
interface Props {
  title: string;
  subtitle?: string;
  rows: Row[];
  nowLabel: string;
  thenLabel?: string;
  source?: string;
  lang?: string;
  id?: string;
  /** 每列高度 px */
  rowH?: number;
  unit?: '億' | '%';
  /** 給了就在資料表加「占比」欄：now / shareOf */
  shareOf?: number;
  shareLabel?: string;
}
const {
  title,
  subtitle,
  rows,
  nowLabel,
  thenLabel,
  source,
  lang = 'zh-TW',
  id,
  rowH = 26,
  unit = '億',
  shareOf,
  shareLabel,
} = Astro.props;

const zh = lang === 'zh-TW';
const uid =
  id ||
  `rb-${Array.from(title).reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7).toString(36)}`;
const max = Math.max(...rows.map((r) => Math.max(r.now, r.then ?? 0)));
const ticks = niceTicks(max, 4);
const top = ticks[ticks.length - 1];
const showThen = unit !== '%' && !!thenLabel;
const fmtV = (v: number) => (unit === '%' ? fmtPct(v, 0) : fmtAxis(v, '億', lang));
const fmtFull = (v: number) => (unit === '%' ? fmtPct(v, 1) : fmtYi(v, lang));
const deltaOf = (r: Row) => (r.then != null && r.then > 0 ? ((r.now - r.then) / r.then) * 100 : null);

function layout(W: number, narrow: boolean) {
  const longestLab = Math.max(0, ...rows.map((r) => estTextW(r.label, 12, 6.5)));
  const maxL = narrow ? 126 : 176;
  // 標籤放不進左欄（en 全名、手機窄版）：改「標籤在條上方」的兩行列，不截字
  const labelTop = longestLab + 14 > maxL;
  const rh = labelTop ? Math.max(rowH, 38) : rowH;
  const M = {
    l: labelTop ? 8 : longestLab + 14,
    r: narrow ? 92 : 128,
    t: 28,
    b: showThen || thenLabel ? 24 : 12,
  };
  const iw = W - M.l - M.r;
  const H = M.t + rows.length * rh + M.b;
  const x = scaleLinear(0, top, M.l, M.l + iw);
  const barH = labelTop ? 12 : Math.max(8, rowH - 12);
  const legendGap = estTextW(nowLabel, 11, 6) + 44;
  return { W, H, M, iw, x, barH, legendGap, narrow, labelTop, rh };
}
const variants = CHART_WIDTHS.map((c) => layout(c.W, c.key === 'narrow'));
---

<figure class="bg-chart" data-chart="rank" id={uid}>
  <h4 class="bg-chart-title" id={`${uid}-h`}>{title}</h4>
  {subtitle && <p class="bg-chart-sub">{subtitle}</p>}
  {
    variants.map((L) => (
      <svg
        viewBox={`0 0 ${L.W} ${L.H}`}
        role="img"
        aria-labelledby={`${uid}-h`}
        class={`bg-svg ${L.narrow ? 'is-narrow' : 'is-wide'}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <title>{title}</title>
        {ticks.map((t) => (
          <g class="bg-grid">
            <line x1={L.x(t)} x2={L.x(t)} y1={L.M.t - 6} y2={L.M.t + rows.length * L.rh} />
            <text x={L.x(t)} y={L.M.t - 10} text-anchor="middle" class="bg-tick">
              {unit === '%' ? `${t}%` : fmtAxis(t, '億', lang)}
            </text>
          </g>
        ))}
        {rows.map((r, i) => {
          const cy = L.labelTop ? L.M.t + i * L.rh + L.rh - 10 : L.M.t + i * L.rh + L.rh / 2;
          const delta = showThen ? deltaOf(r) : null;
          const tipX = L.x(Math.max(r.now, showThen ? (r.then ?? 0) : 0)) + 6;
          return (
            <g class={`bg-row ${r.highlight ? 'is-hi' : ''}`} data-id={r.id}>
              {L.labelTop ? (
                <text x={L.M.l} y={cy - L.barH / 2 - 5} class="bg-rowlab">
                  {r.label}
                </text>
              ) : (
                <text x={L.M.l - 10} y={cy + 4} text-anchor="end" class="bg-rowlab">
                  {r.label}
                </text>
              )}
              <rect x={L.x(0)} y={cy - L.barH / 2} width={Math.max(0, L.x(r.now) - L.x(0))} height={L.barH} rx={3} class="bg-bar">
                <title>{`${r.label} · ${nowLabel}：${fmtFull(r.now)}${showThen && r.then != null ? `｜${thenLabel}：${fmtFull(r.then)}` : ''}`}</title>
              </rect>
              {showThen && r.then != null && (
                <line x1={L.x(r.then)} x2={L.x(r.then)} y1={cy - L.barH / 2 - 3} y2={cy + L.barH / 2 + 3} class="bg-then" />
              )}
              <text x={tipX} y={cy + 4} class="bg-val">
                {fmtV(r.now)}
                {delta !== null && <tspan class={delta >= 0 ? 'bg-up' : 'bg-down'}> {fmtPct(delta, 0)}</tspan>}
              </text>
            </g>
          );
        })}
        {/* 圖例（兩個 marker 需要說明：條＝今年、直槓＝起點年）；unit=% 單序列不需要圖例 */}
        {showThen && (
          <g class="bg-legend" transform={`translate(${L.M.l}, ${L.H - 6})`}>
            <rect x={0} y={-9} width={14} height={8} rx={2} class="bg-bar" />
            <text x={18} y={-2} class="bg-tick">{nowLabel}</text>
            <line x1={L.legendGap} x2={L.legendGap} y1={-12} y2={2} class="bg-then" />
            <text x={L.legendGap + 6} y={-2} class="bg-tick">{thenLabel}</text>
          </g>
        )}
      </svg>
    ))
  }
  {source && <figcaption class="bg-chart-src">{zh ? '來源：' : 'Source: '}{source}</figcaption>}
  <details class="bg-table">
    <summary>{zh ? '資料表' : 'Data table'}</summary>
    <div class="bg-table-wrap">
      <table>
        <thead>
          <tr>
            <th>{zh ? '項目' : 'Item'}</th>
            {showThen && <th class="num">{thenLabel}</th>}
            <th class="num">{nowLabel}</th>
            {shareOf && <th class="num">{shareLabel || (zh ? '占比' : 'Share')}</th>}
            {showThen && <th class="num">{zh ? '增減' : 'Change'}</th>}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => {
              const delta = deltaOf(r);
              return (
                <tr>
                  <td>{r.label}{r.note && <small class="bg-note"> {r.note}</small>}</td>
                  {showThen && <td class="num">{r.then != null ? Math.round(r.then).toLocaleString('en-US') : '—'}</td>}
                  <td class="num">{unit === '%' ? fmtPct(r.now, 1) : Math.round(r.now).toLocaleString('en-US')}</td>
                  {shareOf && <td class="num">{((r.now / shareOf) * 100).toFixed(2)}%</td>}
                  {showThen && <td class="num">{delta === null ? '—' : fmtPct(delta, 1)}</td>}
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>
