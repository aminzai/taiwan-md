---
/**
 * StackedArea — 政事別／機關群 的堆疊面積圖（絕對值或占比 100%）。
 * 直接在右端標類別名（不用圖例）；表格 fallback。顏色跟隨類別 slot 不跟隨排名。
 */
import { scaleLinear, niceTicks, areaPath, linePath, fmtAxis, fmtYi } from '../../utils/budgetViz';

export interface Cat {
  id: string;
  label: string;
  /** colour slot class：bg-cat-0..7 / bg-cat-other */
  cls: string;
}
interface Props {
  title: string;
  years: number[];
  cats: Cat[];
  /** values[catIndex][yearIndex]，單位億元 */
  values: number[][];
  mode?: 'abs' | 'share';
  source?: string;
  lang?: string;
  height?: number;
  id?: string;
  /** 右端標籤最少要多高才標（避免細帶塞字），單位 px */
  minLabelPx?: number;
}
const {
  title,
  years,
  cats,
  values,
  mode = 'abs',
  source,
  lang = 'zh-TW',
  height = 380,
  id,
  minLabelPx = 11,
} = Astro.props;

const W = 760;
const H = height;
const M = { l: 58, r: 150, t: 16, b: 34 };
const iw = W - M.l - M.r;
const ih = H - M.t - M.b;
const n = years.length;

const totals = years.map((_, yi) => cats.reduce((a, _c, ci) => a + (values[ci]?.[yi] ?? 0), 0));
const norm = (ci: number, yi: number) => {
  const v = values[ci]?.[yi] ?? 0;
  return mode === 'share' ? (totals[yi] ? (v / totals[yi]) * 100 : 0) : v;
};
const dataMax = mode === 'share' ? 100 : Math.max(...totals);
const ticks = mode === 'share' ? [0, 25, 50, 75, 100] : niceTicks(dataMax, 5);
const top = ticks[ticks.length - 1];
const x = scaleLinear(years[0], years[n - 1], M.l, M.l + iw);
const y = scaleLinear(0, top, M.t + ih, M.t);

// 累積
const cum: number[][] = [];
let base = new Array(n).fill(0);
for (let ci = 0; ci < cats.length; ci++) {
  const row = years.map((_, yi) => base[yi] + norm(ci, yi));
  cum.push(row);
  base = row;
}
const layers = cats.map((c, ci) => {
  const lower = ci === 0 ? new Array(n).fill(0) : cum[ci - 1];
  const upper = cum[ci];
  const topPts = years.map((yr, yi) => ({ x: x(yr), y: y(upper[yi]) }));
  const botPts = years.map((yr, yi) => ({ x: x(yr), y: y(lower[yi]) }));
  const lastMid = (y(upper[n - 1]) + y(lower[n - 1])) / 2;
  const lastH = y(lower[n - 1]) - y(upper[n - 1]);
  return {
    c,
    ci,
    d: areaPath(topPts, botPts),
    topLine: linePath(topPts),
    lastMid,
    lastH,
    lastVal: norm(ci, n - 1),
  };
});
// 右端標籤：由上到下排、避免重疊；太薄的層不標（值留表格）
const labels = layers
  .map((l) => ({ ...l, ly: l.lastMid, show: l.lastH >= minLabelPx }))
  .sort((a, b) => a.ly - b.ly);
for (let i = 1; i < labels.length; i++) {
  if (labels[i].ly - labels[i - 1].ly < 13) labels[i].ly = labels[i - 1].ly + 13;
}
const zh = lang === 'zh-TW';
const uid =
  id ||
  `sa-${Array.from(title).reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7).toString(36)}`;
const fmtCell = (v: number) =>
  mode === 'share' ? `${v.toFixed(1)}%` : Math.round(v).toLocaleString('en-US');
---

<figure class="bg-chart" data-chart="stacked" id={uid}>
  <h4 class="bg-chart-title" id={`${uid}-h`}>{title}</h4>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-labelledby={`${uid}-h`}
    class="bg-svg"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id={`${uid}-t`}>{title}</title>
    {
      ticks.map((t) => (
        <g class="bg-grid">
          <line x1={M.l} x2={M.l + iw} y1={y(t)} y2={y(t)} />
          <text x={M.l - 8} y={y(t) + 4} text-anchor="end" class="bg-tick">
            {mode === 'share' ? `${t}%` : fmtAxis(t)}
          </text>
        </g>
      ))
    }
    {
      years.map((yr, i) => (
        <text
          x={x(yr)}
          y={M.t + ih + 20}
          text-anchor="middle"
          class="bg-tick"
          opacity={n > 8 && i % 2 === 1 ? 0 : 1}
        >
          {yr}
        </text>
      ))
    }
    {
      layers.map((l) => (
        <g class={`bg-layer ${l.c.cls}`} data-cat={l.c.id}>
          <path d={l.d} class="bg-fill">
            <title>{`${l.c.label}：${years[n - 1]} ${mode === 'share' ? l.lastVal.toFixed(1) + '%' : fmtYi(l.lastVal, lang)}`}</title>
          </path>
        </g>
      ))
    }
    {/* 層與層之間 1.5px 的表面縫（dataviz：2px surface gap） */}
    {
      layers.slice(0, -1).map((l) => (
        <path d={l.topLine} class="bg-seam" fill="none" />
      ))
    }
    <line x1={M.l} x2={M.l + iw} y1={y(0)} y2={y(0)} class="bg-axis" />
    {
      labels
        .filter((l) => l.show)
        .map((l) => (
          <g class={`bg-endlab-g ${l.c.cls}`}>
            <line x1={M.l + iw + 2} x2={M.l + iw + 8} y1={l.lastMid} y2={l.ly} class="bg-leader" />
            <text x={M.l + iw + 11} y={l.ly + 4} class="bg-endlab">
              {l.c.label}
              <tspan class="bg-endlab-v"> {mode === 'share' ? `${l.lastVal.toFixed(0)}%` : fmtAxis(l.lastVal)}</tspan>
            </text>
          </g>
        ))
    }
  </svg>
  {source && <figcaption class="bg-chart-src">{zh ? '來源：' : 'Source: '}{source}</figcaption>}
  <details class="bg-table">
    <summary>{zh ? '資料表' : 'Data table'}</summary>
    <div class="bg-table-wrap">
      <table>
        <thead>
          <tr>
            <th>{zh ? '類別' : 'Category'}</th>
            {years.map((yr) => <th class="num">{yr}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            cats.map((c, ci) => (
              <tr>
                <td>
                  <span class={`bg-swatch ${c.cls}`} aria-hidden="true" /> {c.label}
                </td>
                {years.map((_, yi) => (
                  <td class="num">{fmtCell(norm(ci, yi))}</td>
                ))}
              </tr>
            ))
          }
          <tr class="bg-total">
            <td>{zh ? '合計' : 'Total'}</td>
            {totals.map((t) => (
              <td class="num">{mode === 'share' ? '100%' : Math.round(t).toLocaleString('en-US')}</td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
  </details>
</figure>
