---
// SectionContentAnalysis — 📊 Content Analysis section (#content-analysis).
// Ids/classes are a contract with src/scripts/dashboard-client.js and
// src/styles/dashboard/ — do not rename.
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Content Analysis -->
<section class="section" id="content-analysis">
  <h2 class="section-title">
    {t('dashboard.contentAnalysis.title')}
    <span class="section-timestamp" data-source="articles"></span>
  </h2>
  <p class="section-subtitle">
    {t('dashboard.contentAnalysis.subtitle')}
  </p>
  <div class="content-analysis-grid">
    <div class="ca-chart" id="ca-category-chart"></div>
    <div class="ca-stats" id="ca-stats"></div>
  </div>
</section>
