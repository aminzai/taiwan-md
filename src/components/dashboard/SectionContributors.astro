---
// SectionContributors — 👥 Contribution Leaderboard section (#contributors).
// Ids/classes are a contract with src/scripts/dashboard-client.js and
// src/styles/dashboard/ — do not rename.
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Contribution Leaderboard — Top Contributors (2026-04-19 β) -->
<section class="section" id="contributors">
  <h2 class="section-title">
    {t('dashboard.contributors.title')}
    <span class="section-timestamp" data-source="contributors"></span>
  </h2>
  <p class="section-subtitle">
    {t('dashboard.contributors.subtitle')}
  </p>

  <div class="contributors-overview" id="contributors-overview"></div>

  <h3 class="subsection-title">
    {t('dashboard.contributors.top20')}
  </h3>
  <div class="contributors-leaderboard" id="contributors-leaderboard"></div>

  <h3 class="subsection-title">
    {t('dashboard.contributors.byArea')}
  </h3>
  <div class="contributors-areas" id="contributors-areas"></div>

  <h3 class="subsection-title">
    {t('dashboard.contributors.recentlyJoined')}
  </h3>
  <p class="section-subtitle" style="margin-top:-8px">
    {t('dashboard.contributors.recentlyJoined.desc')}
  </p>
  <div class="contributors-recent" id="contributors-recent"></div>
</section>
