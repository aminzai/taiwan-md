---
// SectionNextSteps — 🎯 Next Steps section (#next-steps). Ids/classes are a
// contract with src/scripts/dashboard-client.js and src/styles/dashboard/ — do not rename.
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Next Steps -->
<section class="section" id="next-steps">
  <h2 class="section-title">{t('dashboard.nextSteps.title')}</h2>
  <p class="section-subtitle">
    {t('dashboard.nextSteps.subtitle')}
  </p>
  <div class="nextsteps-grid" id="nextsteps-grid"></div>
</section>
