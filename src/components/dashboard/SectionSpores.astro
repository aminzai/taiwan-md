---
// SectionSpores — 🌱 Reproduction — Spores & Reach section (#spores). Ids/classes
// are a contract with src/scripts/dashboard-client.js and src/styles/dashboard/
// — do not rename.
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Reproduction System — Spores & Amplification (2026-04-18 δ-late) -->
<section class="section" id="spores">
  <h2 class="section-title">
    {t('dashboard.spores.title')}
    <span class="section-timestamp" data-source="spores"></span>
  </h2>
  <p class="section-subtitle">
    {t('dashboard.spores.subtitle')}
  </p>

  <div class="spores-overview" id="spores-overview"></div>

  <h3 class="subsection-title">
    {t('dashboard.spores.topPerformers')}
  </h3>
  <div class="spores-top" id="spores-top"></div>

  <h3 class="subsection-title">
    {t('dashboard.spores.gaAmplification')}
  </h3>
  <p class="queue-desc">
    {t('dashboard.spores.gaAmplification.desc')}
  </p>
  <div class="spores-amplification" id="spores-amplification"></div>

  <h3 class="subsection-title">
    {t('dashboard.spores.platformComparison')}
  </h3>
  <div class="spores-platforms" id="spores-platforms"></div>

  <h3 class="subsection-title">
    {t('dashboard.spores.backfillStatus')}
  </h3>
  <p class="queue-desc">
    {t('dashboard.spores.backfillStatus.desc')}
  </p>
  <div class="spores-backfill" id="spores-backfill"></div>

  <h3 class="subsection-title">
    {t('dashboard.spores.weeklyPulse')}
  </h3>
  <div class="spores-weekly" id="spores-weekly"></div>
</section>
