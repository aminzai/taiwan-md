  // ── Jansen 十一桿運動學（幾何比較子選分支；驗證 720 步 0 無解） ────
  const J = {
    a: 38,
    b: 41.5,
    c: 39.3,
    d: 40.1,
    e: 55.8,
    f: 39.4,
    g: 36.7,
    h: 65.7,
    i: 49,
    j: 50,
    k: 61.9,
    l: 7.8,
    m: 15,
  };
  type Pt = { x: number; y: number };
  function circInt2(p0: Pt, r0: number, p1: Pt, r1: number): [Pt, Pt] | null {
    const dx = p1.x - p0.x,
      dy = p1.y - p0.y,
      d = Math.hypot(dx, dy);
    if (d > r0 + r1 || d < Math.abs(r0 - r1) || d === 0) return null;
    const A = (r0 * r0 - r1 * r1 + d * d) / (2 * d);
    const hh = Math.sqrt(Math.max(0, r0 * r0 - A * A));
    const mx = p0.x + (A * dx) / d,
      my = p0.y + (A * dy) / d;
    return [
      { x: mx + (hh * dy) / d, y: my - (hh * dx) / d },
      { x: mx - (hh * dy) / d, y: my + (hh * dx) / d },
    ];
  }
  const pick = (pair: [Pt, Pt] | null, key: (p: Pt) => number) =>
    pair ? (key(pair[0]) <= key(pair[1]) ? pair[0] : pair[1]) : null;
  function legJoints(theta: number, mirror: boolean) {
    const s = mirror ? -1 : 1;
    const F = { x: -J.a * s, y: J.l };
    const M = { x: J.m * Math.cos(theta) * s, y: J.m * Math.sin(theta) };
    const p2 = pick(circInt2(M, J.j, F, J.b), (p) => p.y);
    const p3 = pick(circInt2(M, J.k, F, J.c), (p) => -p.y);
    if (!p2 || !p3) return null;
    const p4 = pick(circInt2(F, J.d, p2, J.e), (p) => p.x * s);
    if (!p4) return null;
    const p5 = pick(circInt2(p4, J.f, p3, J.g), (p) => -p.y);
    if (!p5) return null;
    const p7 = pick(circInt2(p5, J.h, p3, J.i), (p) => -p.y);
    if (!p7) return null;
    return { F, M, p2, p3, p4, p5, p7 };
  }

