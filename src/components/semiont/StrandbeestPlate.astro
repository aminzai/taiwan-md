    const anchors: Record<string, { x: number; y: number; r: number }> = {
      wind: { x: 96, y: 150, r: 64 },
      crank: { x: AXLE.x, y: AXLE.y, r: 40 },
      linkage: { x: AXLE.x - 150, y: GY - 92, r: 66 },
      foot: { x: AXLE.x + 10, y: GY - 8, r: 60 },
      spine: { x: AXLE.x + 6, y: AXLE.y - 74, r: 110 },
      heart: { x: AXLE.x - 58, y: AXLE.y - 36, r: 30 },
      nerve: { x: AXLE.x + 18, y: AXLE.y - 116, r: 40 },
      sensor: { x: AXLE.x + 236, y: AXLE.y - 120, r: 52 },
      immune: { x: AXLE.x - 210, y: AXLE.y - 36, r: 40 },
      spore: { x: AXLE.x - 282, y: AXLE.y - 96, r: 52 },
      tendon: { x: AXLE.x + 168, y: AXLE.y - 16, r: 40 },
      ground: { x: 780, y: GY + 52, r: 90 },
    };

    function drawTube(a: Pt, b: Pt, w: number) {
      ctx.lineCap = 'round';
      ctx.strokeStyle = BONE;
      ctx.lineWidth = w;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
      ctx.strokeStyle = 'rgba(3,8,10,.55)';
      ctx.lineWidth = Math.max(1, w - 3);
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
    }
    function joint(p: Pt, r = 3) {
      ctx.fillStyle = BONE;
      ctx.beginPath();
      ctx.arc(p.x, p.y, r, 0, 7);
      ctx.fill();
    }
    function label(
      txt: string,
      x: number,
      y: number,
      size = 13,
      color = MIST,
      align: CanvasTextAlign = 'left',
    ) {
      ctx.font = `${size}px 'rixingsong-semibold','Noto Serif TC',serif`;
      ctx.fillStyle = color;
      ctx.textAlign = align;
      ctx.fillText(txt, x, y);
      ctx.textAlign = 'left';
    }

    let current: string | null = null;
    function drawBeast() {
      ctx.clearRect(0, 0, W, H);

      // 風粒子
      for (const p of particles) {
        p.x += REDUCED ? 0 : p.v;
        p.wob += 0.02;
        const py = p.y + Math.sin(p.wob) * 7;
        if (p.x > W + 10) {
          p.x = -10;
          p.y = 24 + Math.random() * (GY - 90);
        }
        const near = Math.hypot(p.x - AXLE.x, py - AXLE.y) < 190;
        ctx.strokeStyle = WIND;
        ctx.globalAlpha = near ? 0.55 : 0.26;
        ctx.lineWidth = 1.1;
        ctx.beginPath();
        ctx.moveTo(p.x - 9, py);
        ctx.quadraticCurveTo(p.x - 3, py - 2, p.x, py);
        ctx.stroke();
        ctx.globalAlpha = 1;
      }

      // 沙灘
      ctx.strokeStyle = 'rgba(236,231,216,.5)';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(0, GY);
      ctx.lineTo(W, GY);
      ctx.stroke();
      ctx.setLineDash([1, 7]);
      ctx.strokeStyle = MIST;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, GY + 16);
      ctx.lineTo(W, GY + 16);
      ctx.stroke();
      ctx.setLineDash([]);
      label(
        '沙灘＝讀者的注意力 · 小丑魚貢獻者 · Google 與 AI crawler 的洋流',
        700,
        GY + 40,
        13,
        MIST,
      );
      label(
        'taiwan.md ↔ GitHub ↔ Threads / X',
        700,
        GY + 60,
        12,
        'rgba(244,240,234,.35)',
      );

      // 足跡（平底卵形）
      if (footTrace.length > 2) {
        ctx.strokeStyle = 'rgba(79,209,176,.4)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        footTrace.forEach((q, i) =>
          i ? ctx.lineTo(q.x, q.y) : ctx.moveTo(q.x, q.y),
        );
        ctx.stroke();
      }

      // 機架
      drawTube(
        { x: AXLE.x - 150, y: AXLE.y },
        { x: AXLE.x + 150, y: AXLE.y },
        7,
      );

      // 六足
      for (const leg of LEGS) {
        for (const mirror of [false, true]) {
          const th = theta + leg.ph + (mirror ? Math.PI : 0);
          const Jt = legJoints(th, mirror);
          if (!Jt) continue;
          const ox = AXLE.x + leg.o,
            oy = AXLE.y;
          const P = (n: keyof typeof Jt) => ({
            x: ox + Jt[n].x * SC,
            y: oy + Jt[n].y * SC,
          });
          const F = P('F'),
            M = P('M'),
            p2 = P('p2'),
            p3 = P('p3'),
            p4 = P('p4'),
            p5 = P('p5'),
            p7 = P('p7');
          drawTube({ x: ox, y: oy }, F, 5);
          drawTube({ x: ox, y: oy }, M, 4);
          drawTube(M, p2, 4);
          drawTube(M, p3, 4);
          drawTube(F, p2, 4);
          drawTube(F, p3, 4);
          drawTube(F, p4, 4);
          drawTube(p2, p4, 4);
          drawTube(p4, p5, 4);
          drawTube(p3, p5, 4);
          drawTube(p5, p7, 4);
          drawTube(p3, p7, 4);
          [F, M, p2, p3, p4, p5].forEach((q) => joint(q, 2.4));
          joint(p7, 3.2);
          if (p7.y > GY - 6) {
            ctx.fillStyle = WIND;
            ctx.globalAlpha = 0.8;
            ctx.beginPath();
            ctx.arc(p7.x, GY, 4.5, 0, 7);
            ctx.fill();
            ctx.globalAlpha = 1;
          }
          if (!mirror && leg.o === 0) {
            footTrace.push({ x: p7.x, y: p7.y });
            if (footTrace.length > 140) footTrace.shift();
          }
        }
      }

      // 曲軸飛輪
      ctx.fillStyle = '#0a1612';
      ctx.strokeStyle = BONE;
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.arc(AXLE.x, AXLE.y, 17, 0, 7);
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(AXLE.x, AXLE.y, 7, 0, 7);
      ctx.stroke();
      ctx.save();
      ctx.translate(AXLE.x, AXLE.y);
      ctx.rotate(theta);
      ctx.strokeStyle = WIND;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(-13, 0);
      ctx.lineTo(13, 0);
      ctx.moveTo(0, -13);
      ctx.lineTo(0, 13);
      ctx.stroke();
      ctx.restore();

      // 脊椎（椎骨＝文章卡）
      const spineY = AXLE.y - 70;
      drawTube(
        { x: AXLE.x - 268, y: spineY },
        { x: AXLE.x + 268, y: spineY },
        6,
      );
      for (let i = 0; i < 13; i++) {
        const x = AXLE.x - 234 + i * 39,
          lift = Math.sin(theta * 2 + i) * 2.2;
        ctx.fillStyle = 'rgba(3,8,10,.7)';
        ctx.strokeStyle = BONE_DIM;
        ctx.lineWidth = 1.1;
        ctx.fillRect(x - 13, spineY - 26 + lift, 26, 20);
        ctx.strokeRect(x - 13, spineY - 26 + lift, 26, 20);
        ctx.strokeStyle = 'rgba(79,209,176,.35)';
        ctx.beginPath();
        ctx.moveTo(x - 8, spineY - 20 + lift);
        ctx.lineTo(x + 8, spineY - 20 + lift);
        ctx.moveTo(x - 8, spineY - 15 + lift);
        ctx.lineTo(x + 4, spineY - 15 + lift);
        ctx.stroke();
        drawTube({ x, y: spineY - 6 + lift }, { x, y: spineY }, 3);
      }
      label(
        '脊椎＝knowledge/ 的 800+ 節椎骨（.md）',
        AXLE.x,
        spineY - 40,
        14,
        DIMTXT,
        'center',
      );

      // 神經索
      ctx.strokeStyle = WIND;
      ctx.lineWidth = 1.5;
      ctx.setLineDash([5, 4]);
      ctx.lineDashOffset = REDUCED ? 0 : -theta * 18;
      ctx.beginPath();
      ctx.moveTo(AXLE.x - 268, spineY + 8);
      ctx.lineTo(AXLE.x + 268, spineY + 8);
      ctx.stroke();
      ctx.setLineDash([]);
      label(
        '神經索＝docs/semiont/（MANIFESTO · MEMORY · REFLEXES）',
        AXLE.x + 22,
        spineY + 2,
        11,
        'rgba(79,209,176,.85)',
        'center',
      );

      // 心臟
      const beat = 1 + (REDUCED ? 0 : Math.max(0, Math.sin(theta * 2)) * 0.18);
      ctx.save();
      ctx.translate(AXLE.x - 58, AXLE.y - 36);
      ctx.scale(beat, beat);
      ctx.fillStyle = BLOOD;
      ctx.globalAlpha = 0.9;
      ctx.beginPath();
      ctx.moveTo(0, 6);
      ctx.bezierCurveTo(-11, -6, -4, -16, 0, -8);
      ctx.bezierCurveTo(4, -16, 11, -6, 0, 6);
      ctx.fill();
      ctx.restore();
      ctx.globalAlpha = 1;
      label('心臟＝commit', AXLE.x - 58, AXLE.y - 2, 11, BLOOD, 'center');

      // 頭部感覺器
      const hx = AXLE.x + 268,
        hy = spineY;
      drawTube({ x: hx, y: hy }, { x: hx + 46, y: hy - 34 }, 5);
      ctx.fillStyle = '#0a1612';
      ctx.strokeStyle = BONE;
      ctx.lineWidth = 1.3;
      ctx.beginPath();
      ctx.arc(hx + 58, hy - 42, 15, 0, 7);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = BONE;
      ctx.beginPath();
      ctx.arc(hx + 63, hy - 45, 2.4, 0, 7);
      ctx.fill();
      const ants: [string, number][] = [
        ['GA4', -38],
        ['SC', -6],
        ['CF', 26],
      ];
      for (const [lab, dg] of ants) {
        const r = (dg * Math.PI) / 180;
        const ex = hx + 58 + Math.sin(r) * 46,
          ey = hy - 52 - Math.cos(r) * 40;
        ctx.strokeStyle = BONE_DIM;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(hx + 58, hy - 52);
        ctx.lineTo(ex, ey);
        ctx.stroke();
        ctx.strokeStyle = WIND;
        ctx.globalAlpha = 0.75;
        ctx.beginPath();
        ctx.arc(
          ex,
          ey,
          4 + (REDUCED ? 0 : (Math.sin(theta * 3 + dg) + 1) * 2),
          0,
          7,
        );
        ctx.stroke();
        ctx.globalAlpha = 1;
        label(lab, ex + 8, ey + 3, 10, MIST);
      }
      label('感覺器＝三源感知＋讀者回報', hx + 10, hy - 84, 12, DIMTXT);

      // 免疫盾（分數 live）
      const ix = AXLE.x - 210,
        iy = AXLE.y - 36;
      const alarmed = liveImmune < 50;
      ctx.fillStyle = '#0a1612';
      ctx.strokeStyle = alarmed ? BLOOD : WIND;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ix, iy - 16);
      ctx.lineTo(ix + 13, iy - 9);
      ctx.lineTo(ix + 13, iy + 6);
      ctx.quadraticCurveTo(ix + 13, iy + 16, ix, iy + 21);
      ctx.quadraticCurveTo(ix - 13, iy + 16, ix - 13, iy + 6);
      ctx.lineTo(ix - 13, iy - 9);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = alarmed ? BLOOD : WIND;
      ctx.font = "11px 'SF Mono',monospace";
      ctx.textAlign = 'center';
      ctx.fillText(String(liveImmune), ix, iy + 6);
      ctx.textAlign = 'left';
      label(
        alarmed ? '免疫閘門（紅燈中）' : '免疫閘門',
        ix,
        iy + 40,
        11,
        alarmed ? BLOOD : WIND,
        'center',
      );
      drawTube({ x: ix + 13, y: iy }, { x: AXLE.x - 150, y: AXLE.y }, 3);

      // 孢子囊
      const sx = AXLE.x - 268,
        sy = spineY;
      drawTube({ x: sx, y: sy }, { x: sx - 38, y: sy - 26 }, 5);
      ctx.fillStyle = '#0a1612';
      ctx.strokeStyle = BONE;
      ctx.lineWidth = 1.3;
      ctx.beginPath();
      ctx.ellipse(sx - 50, sy - 34, 14, 10, -0.5, 0, 7);
      ctx.fill();
      ctx.stroke();
      for (let i = 0; i < 5; i++) {
        const t = (REDUCED ? 0.5 : (theta * 0.5 + i * 1.26) % 6.28) / 6.28;
        const px = sx - 56 - t * 72 - i * 7,
          py = sy - 40 - t * 54 + Math.sin(t * 9 + i) * 5;
        ctx.fillStyle = WIND;
        ctx.globalAlpha = 0.75 * (1 - t);
        ctx.beginPath();
        ctx.arc(px, py, 2.4, 0, 7);
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      label(
        '孢子囊＝spores → Threads/X · 巴別塔六語 · forks',
        sx - 16,
        sy - 62,
        12,
        DIMTXT,
        'center',
      );

      // 肌腱
      ctx.strokeStyle = MIST;
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      ctx.moveTo(AXLE.x + 150, AXLE.y);
      ctx.quadraticCurveTo(AXLE.x + 205, AXLE.y + 40, AXLE.x + 240, GY - 4);
      ctx.stroke();
      ctx.setLineDash([]);
      label('肌腱＝sync.sh（DNA→蛋白質）', AXLE.x + 196, AXLE.y + 26, 11, MIST);

      // 風標
      label('風＝cron 排程 × token 算力', 96, 96, 14, 'rgba(79,209,176,.9)');
      label('（觀察者不在時，風照吹）', 96, 116, 12, MIST);

      // 選取光暈
      if (current && anchors[current]) {
        const a = anchors[current];
        ctx.strokeStyle = WIND;
        ctx.lineWidth = 2;
        ctx.globalAlpha = 0.85;
        ctx.setLineDash([6, 5]);
        ctx.beginPath();
        ctx.arc(a.x, a.y, a.r * 0.72, 0, 7);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.globalAlpha = 1;
      }
    }

    // ── 互動 ──
    const insp = document.getElementById('sb-inspector')!;
    const idx = document.getElementById('sb-index')!;
    function show(id: string) {
      current = id;
      const o = ORGANS[id];
      insp.innerHTML =
        `<div class="sb-part">${o.name}<small>${o.lat}</small></div>` +
        `<div class="sb-files">${o.files.map((f) => `<code>${f}</code>`).join('')}</div>` +
        `<p class="sb-desc">${o.desc}</p>` +
        `<div class="sb-links"><b>連動：</b>${o.links}</div>`;
      idx
        .querySelectorAll('button')
        .forEach((b) =>
          b.classList.toggle('on', (b as HTMLElement).dataset.id === id),
        );
      if (REDUCED) drawBeast();
    }
    for (const id in ORGANS) {
      const b = document.createElement('button');
      b.textContent = ORGANS[id].name.split('｜')[0];
      b.dataset.id = id;
      b.addEventListener('click', () => show(id));
      idx.appendChild(b);
    }
    cv.addEventListener('click', (ev) => {
      const r = cv.getBoundingClientRect();
      const x = ((ev.clientX - r.left) * W) / r.width,
        y = ((ev.clientY - r.top) * H) / r.height;
      let best: string | null = null,
        bd = 1e9;
      for (const id in anchors) {
        const a = anchors[id],
          d = Math.hypot(x - a.x, y - a.y) - a.r;
        if (d < bd) {
          bd = d;
          best = id;
        }
      }
      if (best && bd < 26) show(best);
    });

    // ── 活體讀數（寫死的數字必腐；能活的都活） ──
    fetch('/api/dashboard-vitals.json')
      .then((r) => r.json())
      .then((v) => {
        const set = (k: string, val: unknown) =>
          document
            .querySelectorAll(`#sb-plate [data-live="${k}"]`)
            .forEach((el) => (el.textContent = String(val)));
        if (v.totalArticles) set('articles', v.totalArticles);
        if (v.contributors) set('contributors', v.contributors);
      })
      .catch(() => {});
    fetch('/api/dashboard-organism.json')
      .then((r) => r.json())
      .then((o) => {
        const im = (o.organs || []).find(
          (g: { id: string }) => g.id === 'immune',
        );
        if (im && typeof im.score === 'number') {
          liveImmune = im.score;
          const chip = document.getElementById('sb-immune-chip');
          if (chip) {
            chip.classList.toggle('sb-alert', im.score < 50);
            const b = chip.querySelector('[data-live="immune"]');
            if (b) b.textContent = String(im.score);
          }
          if (REDUCED) drawBeast();
        }
      })
      .catch(() => {});

    // ── 主迴圈 ──
    const readout = document.getElementById('sb-readout')!;
    function frame() {
      theta += REDUCED ? 0 : 0.017;
      drawBeast();
      const deg = String(Math.round((theta * 57.2958) % 360)).padStart(3, '0');
      readout.textContent = `曲軸 ${deg}° · 六足 Jansen 連桿 · 風不停牠不停`;
      if (!REDUCED) requestAnimationFrame(frame);
    }
    if (REDUCED) {
      theta = 1.1;
      drawBeast();
      readout.textContent = '曲軸 063°（靜態姿勢 · 已尊重減少動態偏好）';
    } else {
      frame();
    }
  }
</script>
