---
import SemiontPageTemplate from '../../templates/semiont-page.template.astro';
import StrandbeestPlate from '../../components/semiont/StrandbeestPlate.astro';
import { loadSemiontPage } from '../../lib/semiont-page';

const page = await loadSemiontPage('ANATOMY.md');
---

<SemiontPageTemplate
  title="器官地圖"
  description="Taiwan.md 的身體結構：會走路的風力獸解剖圖版（Jansen 連桿運動學，每個部位對映 repo 真實檔案）+ 8 個身體器官和認知層的完整解剖。"
  filename="ANATOMY.md"
  subtitle="風力獸解剖圖版 · 8 身體器官 + 8 認知器官 + 2 運作原則"
  html={page.html}
  headings={page.headings}
  wordCount={page.wordCount}
  emoji="🫀"
  breadcrumbLabel="anatomy"
>
  <StrandbeestPlate slot="hero" />
</SemiontPageTemplate>
