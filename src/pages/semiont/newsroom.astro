---
import Layout from '../../layouts/Layout.astro';
import '../../styles/semiont.css';
// ─────────────────────────────────────────────────────────────────────────────
// 共享編輯台（Newsroom）— 公開唯讀 · beta · v2 總編輯視角
//
// v2（2026-07-16 哲宇 directive）：橫向 kanban 改成產線泳道表——
// 一列一篇進行中文章、階段格子由左至右、hover 看該階段細節、列可展開
// 看「為什麼在這裡、下一步怎麼推」。收件佇列與休眠摺疊，出刊壓縮成名單。
// 資料：scripts/core/generate-newsroom-data.py（檔案現況推導，無第二本帳）。
// ─────────────────────────────────────────────────────────────────────────────
import board from '../../../public/api/dashboard-newsroom.json';

const GH = 'https://github.com/frank890417/taiwan-md/blob/main/';

// 泳道表階段欄（左→右 = 執行序；對齊 REWRITE-STAGE-* 序列命名）
const LANES = [
  {
    id: 'viewpoint',
    short: '0',
    name: '觀點',
    contract: 'REWRITE-STAGE-0-VIEWPOINT.md',
  },
  {
    id: 'research',
    short: '1A',
    name: '研究',
    contract: 'REWRITE-STAGE-1A-RESEARCH.md',
  },
  {
    id: 'projection',
    short: '2A',
    name: '投影',
    contract: 'REWRITE-STAGE-2A-PROJECTION.md',
  },
  {
    id: 'room_projection',
    short: '2B',
    name: '投影室',
    contract: 'REWRITE-STAGE-2B-ROOM-PROJECTION.md',
  },
  {
    id: 'write',
    short: '2C',
    name: '寫作',
    contract: 'REWRITE-STAGE-2C-WRITE.md',
  },
  {
    id: 'room_prose',
    short: '2E',
    name: '正文室',
    contract: 'REWRITE-STAGE-2E-ROOM-PROSE.md',
  },
  {
    id: 'verify',
    short: '3',
    name: '驗證',
    contract: 'REWRITE-STAGE-3-VERIFY.md',
  },
  {
    id: 'room_chief',
    short: '3.7',
    name: '總編',
    contract: 'REWRITE-STAGE-3-VERIFY.md',
  },
  {
    id: 'ship',
    short: '✓',
    name: '出刊',
    contract: 'REWRITE-STAGE-5-CROSSLINK.md',
  },
];

type Card = (typeof board.articles)[number];
const inbox: Card[] = [];
const dormant: Card[] = [];
const shipped: Card[] = [];
const blocked: Card[] = [];
const inflight: Card[] = [];
for (const a of board.articles) {
  const col = (a as any).board_column ?? 'inbox';
  if (col === 'shipped') shipped.push(a);
  else if (col === 'inbox') inbox.push(a);
  else if (col === 'dormant') dormant.push(a);
  else if (col === 'blocked') blocked.push(a);
  else inflight.push(a);
}

const GLYPH: Record<string, { g: string; cls: string; label: string }> = {
  done: { g: '●', cls: 'ok', label: '完成' },
  pass: { g: '●', cls: 'ok', label: 'pass' },
  staged: { g: '●', cls: 'ok', label: 'staging 落檔' },
  'in-progress': { g: '◐', cls: 'mid', label: '進行中' },
  revise: { g: '◐', cls: 'mid', label: 'revise 回修' },
  pending: { g: '○', cls: 'dim', label: '待做' },
  block: { g: '✕', cls: 'bad', label: 'block' },
  blocked: { g: '✕', cls: 'bad', label: '卡關' },
};

function cell(a: Card, laneId: string) {
  const st = (a.stages as Record<string, any>)[laneId];
  if (!st) return { g: '·', cls: 'none', tip: null, href: null };
  const gl = GLYPH[st.status] ?? { g: '○', cls: 'dim', label: st.status };
  const bits = [gl.label];
  if (st.rounds) bits.push(`${st.rounds} 輪`);
  if (st.stage35) bits.push(`3.5:${st.stage35}`);
  if (st.stage36) bits.push(`3.6:${st.stage36}`);
  if (st.at) bits.push(st.at.slice(0, 10));
  return {
    g: gl.g,
    cls: gl.cls,
    tip: bits.join(' · '),
    href: st.artifact ? GH + st.artifact : null,
  };
}

function currentLane(a: Card) {
  const col = (a as any).board_column;
  return LANES.findIndex((l) => l.id === col);
}

function hasMakingOf(a: Card) {
  const s = a.stages as Record<string, any>;
  return !!(s.projection || s.room_projection || s.room_prose || s.room_chief);
}
function makingOfHref(a: Card) {
  return `/semiont/newsroom/${encodeURIComponent(a.slug)}/`;
}

function artifacts(a: Card) {
  return Object.entries(a.stages as Record<string, any>)
    .filter(([, v]) => v.artifact)
    .map(([k, v]) => ({
      lane: LANES.find((l) => l.id === k)?.name ?? k,
      href: GH + v.artifact,
      status: v.status,
    }));
}

const prio = (a: Card) =>
  ({ P0: 0, P1: 1, P2: 2, P3: 3 })[(a.priority ?? '').trim()] ?? 4;
const inboxByPrio: Record<string, Card[]> = {
  P0: [],
  P1: [],
  P2: [],
  P3: [],
  其他: [],
};
for (const a of inbox)
  (inboxByPrio[(a.priority ?? '').trim()] ?? inboxByPrio['其他']).push(a);

const shippedShow = shipped.slice(0, 12);
const generatedAt = new Date(board.generated).toLocaleString('zh-TW', {
  timeZone: 'Asia/Taipei',
  hour12: false,
});
---

<Layout
  title="共享編輯台 — Taiwan.md Newsroom（beta）"
  description="Taiwan.md 的公開編輯台：每篇文章在生產線的哪一站、產出了什麼、下一步怎麼推進，總編輯視角一眼看完。"
  lang="zh-TW"
>
  <main class="newsroom semiont-paper">
    <header class="nr-head">
      <p class="nr-eyebrow">
        SEMIONT NEWSROOM <span class="nr-beta">beta</span>
      </p>
      <h1>共享編輯台</h1>
      <p class="nr-lede">
        這是 Taiwan.md 的編輯台，對所有人打開。每篇文章怎麼被想（觀點與投影）、
        被吵（編輯室分席對抗）、被驗（事實查核與成品總驗），生產狀態攤在這裡。
        看板由生產線的檔案現況直接推導，沒有第二本帳。第一階段唯讀。
      </p>
      <div class="nr-stats">
        <span class="nr-stat"
          ><b>{inflight.length + blocked.length}</b> 產線上</span
        >
        <span class="nr-stat"><b>{inbox.length}</b> 收件</span>
        <span class="nr-stat"><b>{shipped.length}</b> 已出刊</span>
        <span class="nr-stat dim">{generatedAt} 更新</span>
      </div>
      <p class="nr-meta">
        產線規格
        <a
          href={GH + 'docs/pipelines/REWRITE-PIPELINE.md'}
          target="_blank"
          rel="noopener">REWRITE-PIPELINE v9</a
        > ·
        <a href="/about/文章如何誕生/">文章如何誕生 →</a>
      </p>
    </header>

    {
      blocked.length > 0 && (
        <section class="nr-alert">
          <h2>🚧 卡關（優先處理）</h2>
          {blocked.map((a) => (
            <p>
              <strong>{a.title}</strong> — 卡在 {(a as any).blocked_on}：
              {a.next_step}
            </p>
          ))}
        </section>
      )
    }

    <section class="nr-section">
      <h2>🛠 產線上（{inflight.length}）</h2>
      <p class="nr-section-desc">
        一列一篇。格子由左至右是產線順序（欄名＝stage contract
        編號）；懸停格子看該階段細節，
        點列展開看「為什麼在這裡、下一步怎麼推」。
      </p>
      <div class="nr-tablewrap">
        <table class="nr-lane">
          <thead>
            <tr>
              <th class="nr-th-title">文章</th>
              {
                LANES.map((l) => (
                  <th title={l.name}>
                    <span class="nr-lane-short">{l.short}</span>
                    <span class="nr-lane-name">{l.name}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              inflight.map((a) => (
                <>
                  <tr class="nr-row">
                    <td class="nr-td-title">
                      <details>
                        <summary>
                          <span class="nr-title-text">{a.title}</span>
                          <span class="nr-row-badges">
                            {a.priority && (
                              <span class="nr-badge pri">{a.priority}</span>
                            )}
                            {a.category && (
                              <span class="nr-badge">{a.category}</span>
                            )}
                            {a.mode && <span class="nr-badge">{a.mode}</span>}
                          </span>
                        </summary>
                        <div class="nr-detail">
                          {a.spine_type && (
                            <p>
                              spine：
                              <span class="nr-badge spine">{a.spine_type}</span>
                            </p>
                          )}
                          <p class="nr-detail-next">
                            <strong>下一步：</strong>
                            {a.next_step ?? '照燈號推進'}
                          </p>
                          <button
                            class="nr-advance"
                            data-slug={a.slug}
                            data-title={a.title}
                            data-next={a.next_step ?? ''}
                            hidden
                          >
                            ▶ 建立推進任務（Harvest 駕駛艙派發）
                          </button>
                          <p>
                            <strong>階段產物：</strong>
                            {artifacts(a).map((x) => (
                              <a
                                class="nr-artifact"
                                href={x.href}
                                target="_blank"
                                rel="noopener"
                              >
                                {x.lane} ↗
                              </a>
                            ))}
                            {hasMakingOf(a) && (
                              <a
                                class="nr-artifact nr-makingof"
                                href={makingOfHref(a)}
                              >
                                🏛️ 編輯台紀錄 →
                              </a>
                            )}
                          </p>
                        </div>
                      </details>
                    </td>
                    {LANES.map((l, i) => {
                      const c = cell(a, l.id);
                      const cur = currentLane(a) === i;
                      return (
                        <td class={`nr-cell ${c.cls} ${cur ? 'nr-cur' : ''}`}>
                          {c.href ? (
                            <a
                              href={c.href}
                              data-tip={`${l.name}：${c.tip}（點開產物）`}
                            >
                              {c.g}
                            </a>
                          ) : (
                            <span
                              data-tip={
                                c.tip
                                  ? `${l.name}：${c.tip}`
                                  : `${l.name}：尚未到站`
                              }
                            >
                              {c.g}
                            </span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                </>
              ))
            }
            {
              inflight.length === 0 && (
                <tr>
                  <td colspan={LANES.length + 1} class="nr-empty">
                    產線淨空——收件佇列裡挑一篇開工吧。
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
      <p class="nr-legend">
        ● 完成／pass　◐ 進行中／revise　○ 待做　✕ 卡關　· 尚未到站。欄位編號＝
        <a href={GH + 'docs/pipelines/'} target="_blank" rel="noopener"
          >REWRITE-STAGE contract</a
        > 序列。
      </p>
    </section>

    <section class="nr-section">
      <h2>📥 收件佇列（{inbox.length}）</h2>
      {
        (['P0', 'P1', 'P2', 'P3', '其他'] as const).map((p) =>
          inboxByPrio[p].length ? (
            <details class="nr-queue" open={p === 'P0'}>
              <summary>
                <span class={`nr-badge pri`}>{p}</span> {inboxByPrio[p].length}{' '}
                篇
              </summary>
              <ul>
                {inboxByPrio[p].map((a) => (
                  <li>
                    {a.title}
                    {a.category && <span class="nr-badge">{a.category}</span>}
                    {a.mode && <span class="nr-badge">{a.mode}</span>}
                  </li>
                ))}
              </ul>
            </details>
          ) : null,
        )
      }
    </section>

    <section class="nr-section">
      <h2>✅ 近期出刊（{shipped.length}）</h2>
      <ul class="nr-shipped">
        {
          shippedShow.map((a) => (
            <li>
              <a href={GH + ((a.stages as any)?.ship?.artifact ?? '')}>
                {a.title}
              </a>
              {hasMakingOf(a) && (
                <a class="nr-makingof" href={makingOfHref(a)}>
                  🏛️
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    {
      dormant.length > 0 && (
        <section class="nr-section">
          <details class="nr-queue">
            <summary>
              🗄️ 休眠（{dormant.length}）— 21 天無產物動靜，可隨時接手續跑
            </summary>
            <ul>
              {dormant.map((a) => (
                <li>
                  {a.title}
                  {artifacts(a).map((x) => (
                    <a
                      class="nr-artifact"
                      href={x.href}
                      target="_blank"
                      rel="noopener"
                    >
                      {x.lane} ↗
                    </a>
                  ))}
                </li>
              ))}
            </ul>
          </details>
        </section>
      )
    }

    <footer class="nr-foot">
      <p class="nr-local-note" hidden>
        🔌 本機模式：Harvest backend 已連線——展開產線列可直接建立推進任務
        （任務進駕駛艙 pending 佇列，由你派發）。主站上同一介面維持唯讀。
      </p>
      <p>
        每個燈號背後都是公開 repo
        裡活著的檔案：研究報告、投影藍圖、編輯室審查逐字稿。
        這個看板是「編輯室對抗」與「思考脈絡公開化」實驗的一部分（2026-07-16
        誕生， 源自哲宇與辯論教育者陳睨的對話）。回饋歡迎開
        <a href="https://github.com/frank890417/taiwan-md/issues">issue</a>。🧬
      </p>
    </footer>
  </main>
</Layout>

<script is:inline>
  // 本機控制模式（哲宇 2026-07-16 directive）：localhost 且 Harvest backend
  // （port 4319）活著 → 看板同時是控制介面；production 無 backend，自然唯讀。
  (async () => {
    const h = location.hostname;
    if (h !== 'localhost' && h !== '127.0.0.1') return;
    const API = 'http://127.0.0.1:4319/api';
    try {
      const r = await fetch(API + '/health', {
        signal: AbortSignal.timeout(1500),
      });
      if (!r.ok) return;
    } catch {
      return;
    }
    const note = document.querySelector('.nr-local-note');
    if (note) note.hidden = false;
    document.querySelectorAll('.nr-advance').forEach((btn) => {
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = '建立中…';
        const d = btn.dataset;
        try {
          const res = await fetch(API + '/tasks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              type: 'article-rewrite',
              boot_profile: 'content-writing',
              priority: 'P1',
              title: `推進產線：${d.title}`,
              notes:
                `共享編輯台推進請求 — 文章「${d.title}」（slug: ${d.slug}）。` +
                `下一步：${d.next || '照看板燈號'}。只執行這一個 stage：完整讀該 ` +
                `stage contract（docs/pipelines/REWRITE-STAGE-*.md，路徑在下一步字串內），` +
                `照 AGENT PROMPT／交付條件／GATES 執行，完成照 HANDOFF 跑 ` +
                `generate-newsroom-data.py 更新編輯台。`,
            }),
          });
          btn.textContent = res.ok
            ? '✓ 任務已進駕駛艙佇列'
            : '建立失敗 HTTP ' + res.status;
        } catch {
          btn.textContent = '連不上 Harvest backend';
          btn.disabled = false;
        }
      });
    });
  })();
</script>

