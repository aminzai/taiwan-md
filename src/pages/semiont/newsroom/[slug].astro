---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/semiont.css';
// ─────────────────────────────────────────────────────────────────────────────
// 編輯室現場（Making-of theater）— 公開唯讀 · beta · v2
//
// v2（2026-07-16 哲宇 directive）：從「產物陳列」升級成「看得見思考怎麼打架」：
// 階段軌道（這篇走到哪）→ 投影論點（戰場）→ 各席開火（頭像對話）→ 攻防
// （挑戰左、答辯右、裁決中）→ 主編拍板。多輪 review 依序演進（revise → pass
// 的過程就是睨說的「爭議過程」）。捲動進場動畫、零框架 JS。
// 資料：src/lib/semiont-newsroom.ts ＋ dashboard-newsroom.json（階段軌道）。
// ─────────────────────────────────────────────────────────────────────────────
import { getMakingOfSlugs, getMakingOf } from '../../../lib/semiont-newsroom';
import type { ReviewData } from '../../../lib/semiont-newsroom';
import board from '../../../../public/api/dashboard-newsroom.json';

export async function getStaticPaths() {
  const slugs = await getMakingOfSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const makingOf = await getMakingOf(slug);
const { projection, projectionFile, reviews } = makingOf;

const GH = 'https://github.com/frank890417/taiwan-md/blob/main/';

// 階段軌道：從看板資料撈這篇的燈號
const boardRec = (board as any).articles.find((a: any) => a.slug === slug);
const RAIL = [
  { id: 'viewpoint', short: '0', name: '觀點' },
  { id: 'research', short: '1A', name: '研究' },
  { id: 'projection', short: '2A', name: '投影' },
  { id: 'room_projection', short: '2B', name: '投影室' },
  { id: 'write', short: '2C', name: '寫作' },
  { id: 'room_prose', short: '2E', name: '正文室' },
  { id: 'verify', short: '3', name: '驗證' },
  { id: 'room_chief', short: '3.7', name: '總編' },
  { id: 'ship', short: '✓', name: '出刊' },
];
function railState(id: string): 'ok' | 'mid' | 'bad' | 'none' {
  const st = boardRec?.stages?.[id]?.status;
  if (!st) return 'none';
  if (['done', 'pass', 'staged'].includes(st)) return 'ok';
  if (['block', 'blocked', 'FAIL'].includes(st)) return 'bad';
  return 'mid';
}
const shipArtifact = boardRec?.stages?.ship?.artifact as string | undefined;
const articleHref = shipArtifact
  ? '/' + shipArtifact.replace(/^knowledge\//, '').replace(/\.md$/, '/')
  : null;
const articleTitle =
  boardRec?.title && boardRec.title !== slug ? boardRec.title : slug;

const ROOM_LABEL: Record<string, string> = {
  projection: '投影室',
  'prose-structure': '正文結構室',
  chief: '總編室',
};
const ROOM_DESC: Record<string, string> = {
  projection:
    '藍圖還沒給寫手之前，三席先吵一輪：結構站不站得住、減法誠不誠實、會不會炎上。',
  'prose-structure':
    '正文寫完，兩席驗收：藍圖有沒有被執行、論點有沒有在中段被賺到。',
  chief: '總編冷讀成品：不看藍圖、不看研究，只問這篇作為一篇報導成不成立。',
};
function roomLabel(room: string): string {
  return ROOM_LABEL[room] ?? (room ? room : '編輯室');
}

// 席位頭像（依席名 substring 對映）
function seatAvatar(name: string): string {
  if (name.includes('結構')) return '📐';
  if (name.includes('減法')) return '✂️';
  if (name.includes('炎上') || name.includes('倫理')) return '🔥';
  if (name.includes('兌現') || name.includes('論點')) return '🎯';
  if (name.includes('總編') || name.includes('門面') || name.includes('主軸'))
    return '🗞️';
  if (name.includes('事實') || name.includes('查核')) return '🔬';
  return '🧑‍💼';
}

function verdictClass(v: string): 'ok' | 'mid' | 'bad' {
  const m = v.match(/^\s*(pass|revise|block|blocked)/i);
  if (!m) return 'mid';
  const w = m[1].toLowerCase();
  if (w === 'pass') return 'ok';
  if (w === 'block' || w === 'blocked') return 'bad';
  return 'mid';
}
function verdictLabel(v: string): string {
  return v && v.trim() ? v.trim() : '（未標註）';
}

// 多輪演進：同 room 的 reviews 依檔名 -rN 排序（lib 已排），標輪次
const roomsSeen = new Map<string, number>();
const reviewsWithRound = reviews.map((r) => {
  const n = (roomsSeen.get(r.room) ?? 0) + 1;
  roomsSeen.set(r.room, n);
  return { ...r, roundLabel: n };
});
const multiRound = new Set(
  [...roomsSeen.entries()].filter(([, n]) => n > 1).map(([room]) => room),
);

const rawFiles = Array.from(
  new Set([
    ...(projectionFile ? [projectionFile] : []),
    ...reviews.map((r) => r.file),
  ]),
);
---

<Layout
  title={`編輯室現場：${articleTitle} — Taiwan.md Newsroom（beta）`}
  description={`看「${articleTitle}」在 AI 新聞台裡怎麼被想（投影論點）、被吵（分席對抗與攻防）、被驗——思考脈絡全部攤開。`}
  lang="zh-TW"
>
  <div class="mk-shell semiont-paper">
    <main class="mk">
      <header class="mk-head">
        <p class="mk-eyebrow">
          SEMIONT NEWSROOM <span class="mk-beta">beta</span>
        </p>
        <h1>編輯室現場</h1>
        <p class="mk-lede">
          {
            articleHref ? (
              <a href={articleHref}>{articleTitle}</a>
            ) : (
              articleTitle
            )
          }
          ——這篇文章怎麼被想、被吵、被驗，思考的每一步都留了檔。
        </p>
        <p class="mk-back"><a href="/semiont/newsroom">← 回共享編輯台</a></p>
      </header>

      {
        boardRec && (
          <section class="mk-rail reveal" aria-label="產線軌道">
            {RAIL.map((r, i) => (
              <span class="mk-rail-stop">
                <span class={`mk-rail-dot ${railState(r.id)}`}>{r.short}</span>
                <span class="mk-rail-name">{r.name}</span>
                {i < RAIL.length - 1 && <span class="mk-rail-line" />}
              </span>
            ))}
          </section>
        )
      }

      {
        projection && (
          <section class="mk-card mk-projection reveal">
            <h2>
              📐 開場：總編輯的投影藍圖
              {projection.spineType && (
                <span class="mk-badge spine">{projection.spineType}</span>
              )}
            </h2>
            <p class="mk-meta">
              {projection.date && <>投影日期 {projection.date} · </>}
              寫手動筆之前，先決定這篇要說什麼、砍什麼。
            </p>
            {projection.thesisHtml && (
              <div class="mk-block">
                <h3>論點（這篇要賺到的一句話）</h3>
                <div class="mk-quote" set:html={projection.thesisHtml} />
              </div>
            )}
            {projection.skeletonHtml && (
              <details class="mk-fold">
                <summary>骨架（動作序列）</summary>
                <div class="mk-prose" set:html={projection.skeletonHtml} />
              </details>
            )}
            {projection.subtractionHtml && (
              <details class="mk-fold">
                <summary>減法（刻意不寫的）</summary>
                <div class="mk-prose" set:html={projection.subtractionHtml} />
              </details>
            )}
          </section>
        )
      }

      {
        reviewsWithRound.length === 0 && (
          <section class="mk-card mk-empty reveal">
            <p>
              目前沒有找到編輯室審查紀錄（這篇可能還沒走到編輯室，或走的是舊制產線）。
            </p>
          </section>
        )
      }

      {
        reviewsWithRound.map((review) => (
          <section class="mk-card mk-room reveal">
            <h2>
              🏛️ {roomLabel(review.room)}
              {multiRound.has(review.room) && (
                <span class="mk-badge round">第 {review.roundLabel} 輪</span>
              )}
              {review.overall && (
                <span class={`mk-badge v-${verdictClass(review.overall)}`}>
                  {verdictLabel(review.overall)}
                </span>
              )}
            </h2>
            <p class="mk-meta">
              {ROOM_DESC[review.room] ?? ''}
              {review.date && <> · {review.date}</>} ·
              <a href={GH + review.file} target="_blank" rel="noopener">
                原始審查檔 ↗
              </a>
            </p>

            {review.seats.length > 0 && (
              <div class="mk-seats">
                {review.seats.map((seat) => (
                  <div
                    class={`mk-bubble seat-${verdictClass(seat.verdict)} reveal`}
                  >
                    <p class="mk-bubble-head">
                      <span class="mk-avatar">{seatAvatar(seat.name)}</span>
                      <span class="mk-seat-name">{seat.name}</span>
                      <span class={`mk-badge v-${verdictClass(seat.verdict)}`}>
                        {verdictLabel(seat.verdict)}
                      </span>
                    </p>
                    <div class="mk-bubble-body" set:html={seat.findingsHtml} />
                  </div>
                ))}
              </div>
            )}

            {review.mustFix.length > 0 && (
              <div class="mk-mustfix reveal">
                <h3>⚡ 必改清單（主編收斂各席意見）</h3>
                <ol>
                  {review.mustFix.map((item) => (
                    <li set:html={item} />
                  ))}
                </ol>
              </div>
            )}

            {review.debate && review.debate.length > 0 && (
              <div class="mk-debate">
                <h3>⚔️ 攻防（寫方有一次答辯權）</h3>
                {review.debate.map((d) => (
                  <div class="mk-debate-item reveal">
                    {d.challenge && (
                      <div class="mk-fight challenge">
                        <span class="mk-fight-who">🏛️ 席位</span>
                        <div class="mk-fight-text" set:html={d.challenge} />
                      </div>
                    )}
                    {d.defense && (
                      <div class="mk-fight defense">
                        <span class="mk-fight-who">✍️ 寫方</span>
                        <div class="mk-fight-text" set:html={d.defense} />
                      </div>
                    )}
                    {d.ruling && (
                      <div class="mk-fight ruling">
                        <span class="mk-fight-who">⚖️ 主編</span>
                        <div class="mk-fight-text" set:html={d.ruling} />
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}

            {review.rulingHtml && (
              <div class="mk-bubble mk-ruling reveal">
                <p class="mk-bubble-head">
                  <span class="mk-avatar">⚖️</span>
                  <span class="mk-seat-name">主編裁決</span>
                </p>
                <div class="mk-bubble-body" set:html={review.rulingHtml} />
              </div>
            )}
          </section>
        ))
      }

      <footer class="mk-foot">
        <p>這裡的每一句吵架都有原始檔，全部活在公開 repo：</p>
        <ul class="mk-raw-list">
          {
            rawFiles.map((f) => (
              <li>
                <a href={GH + f} target="_blank" rel="noopener">
                  {f}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mk-foot-note">
          「編輯室現場」是思考脈絡公開化實驗的一部分（2026-07-16
          誕生，源自哲宇與
          辯論教育者陳睨的對話：「會非常有趣，如果有爭議過程的話」）。回饋歡迎開
          <a
            href="https://github.com/frank890417/taiwan-md/issues"
            target="_blank"
            rel="noopener">issue</a
          >。🧬
        </p>
      </footer>
    </main>
  </div>
</Layout>

<script is:inline>
  // 捲動進場：IntersectionObserver 逐個 reveal（無框架、prefers-reduced-motion 尊重）
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.08 },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  } else {
    document
      .querySelectorAll('.reveal')
      .forEach((el) => el.classList.add('is-in'));
  }
</script>

