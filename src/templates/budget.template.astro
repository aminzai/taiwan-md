        </div>

        <h3 class="bp-h3">{t('budget.s7.sources.h')}</h3>
        <div class="bp-prose">
          <p>{t('budget.s7.sources.p')}</p>
        </div>
        <ul class="bp-sources">
          {
            sources.map((s: any) => (
