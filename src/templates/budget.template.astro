          <figcaption class="bg-chart-src">
            {t('budget.s6.defense.function')}：{defense.function_only.toLocaleString('en-US')} · <a href={defense.source} target="_blank" rel="noopener">DGBAS</a> · <a href={defense.source2} target="_blank" rel="noopener">MyGoPen</a>
