        <h3 class="bp-h3">{t('budget.s7.related.h')}</h3>
        <div class="bp-related">
          {relTaicca && <a href={relTaicca}>🎬 {t('budget.s7.related.taicca')}</a>}
          {relPts && <a href={relPts}>📺 {t('budget.s7.related.pts')}</a>}
          {relRecall && <a href={relRecall}>🗳️ {t('budget.s7.related.recall')}</a>}
          {relPolitics && <a href={relPolitics}>🏛️ {t('budget.s7.related.politics')}</a>}
          <a href={translatePath('/data')}>📊 {t('budget.s7.related.data')}</a>
          <a href={translatePath('/companies')}>🏢 {t('budget.s7.related.companies')}</a>
          <a href={translatePath('/opendata')}>🗂️ {t('budget.s7.related.opendata')}</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    // 漸進增強：折線圖 hover 交叉線 + 讀 <title> 顯示 tooltip。無 JS 時原生 <title> 仍可用。
    document.querySelectorAll<HTMLElement>('.bg-chart[data-chart="line"]').forEach((fig) => {
      const svg = fig.querySelector('svg');
      if (!svg) return;
      const dots = Array.from(svg.querySelectorAll<SVGCircleElement>('circle.bg-dot'));
      if (!dots.length) return;
      const tip = document.createElement('div');
      tip.className = 'bg-tip';
      fig.appendChild(tip);
      const vb = svg.viewBox.baseVal;
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('class', 'bg-hover-line');
      line.setAttribute('y1', '0');
      line.setAttribute('y2', String(vb.height));
      line.style.display = 'none';
      svg.appendChild(line);
      const xs = Array.from(new Set(dots.map((d) => +d.getAttribute('cx')!))).sort((a, b) => a - b);
      svg.addEventListener('pointermove', (ev) => {
        const r = svg.getBoundingClientRect();
        const px = ((ev.clientX - r.left) / r.width) * vb.width;
        let best = xs[0];
        for (const x of xs) if (Math.abs(x - px) < Math.abs(best - px)) best = x;
        line.setAttribute('x1', String(best));
        line.setAttribute('x2', String(best));
        line.style.display = '';
        const rows = dots
          .filter((d) => +d.getAttribute('cx')! === best)
          .map((d) => d.querySelector('title')?.textContent || '')
          .filter(Boolean);
        tip.innerHTML = rows.map((s) => `<div>${s}</div>`).join('');
        tip.classList.add('is-on');
        const fr = fig.getBoundingClientRect();
        const left = ((best / vb.width) * r.width) + (r.left - fr.left);
        tip.style.left = `${Math.min(Math.max(8, left + 12), fr.width - 270)}px`;
        tip.style.top = `${r.top - fr.top + 8}px`;
      });
      svg.addEventListener('pointerleave', () => {
        line.style.display = 'none';
        tip.classList.remove('is-on');
      });
    });
  </script>
</Layout>
