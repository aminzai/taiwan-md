        </div>
        <p class="bp-note">{t('budget.s6.note')}</p>
      </div>
    </section>

    <!-- §7 怎麼讀 -->
    <section class="bp-section" id="s7">
      <div class="bp-wrap">
        <blockquote class="bp-kicker">{t('budget.s7.kicker')}</blockquote>
