---
import Layout from '../layouts/Layout.astro';
import '../styles/dashboard.css';
import PageHero from '../components/PageHero.astro';
import SupporterTimeline from '../components/SupporterTimeline.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import fs from 'fs';
import path from 'path';
import { LANGUAGE_DISPLAY_NAMES } from '../config/languages.mjs';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === 'en';

// ── 🩺 營運狀態 section 資料（2026-07-24，per
//    reports/design-dashboard-status-section-2026-07-24.md §六）
//    這是本頁唯一 build-time 讀 JSON、直接烘進 HTML 的 section —— 其餘
//    section 都是 client fetch + dashboard-client.js 渲染。uptime 網格
//    刻意要求零 client JS（graph.md visible-by-default 鐵律），所以在
//    frontmatter 直接讀 scripts/core/generate-dashboard-status.mjs 的產出，
//    跟 bench.template.astro 讀 bench-results.json 同一種手法。
const opsStatusPath = path.join(
  process.cwd(),
  'public/api/dashboard-status.json',
);
const opsStatus = fs.existsSync(opsStatusPath)
  ? JSON.parse(fs.readFileSync(opsStatusPath, 'utf-8'))
  : null;

function opsRelTime(iso) {
  if (!iso) return isEn ? 'never fired' : '從未 fire';
  const diffMs = Date.now() - new Date(iso).getTime();
  if (diffMs < 0) return isEn ? 'just now' : '剛剛';
  const mins = Math.floor(diffMs / 60000);
  if (mins < 60) return isEn ? `${mins}m ago` : `${mins} 分鐘前`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return isEn ? `${hours}h ago` : `${hours} 小時前`;
  const days = Math.floor(hours / 24);
  return isEn ? `${days}d ago` : `${days} 天前`;
}

function opsGapArrow(delta) {
  if (!delta) return '=0';
  return delta > 0 ? `▲${delta}` : `▼${Math.abs(delta)}`;
}

const OPS_STATUS_LABEL = {
  operational: isEn ? 'Operational' : '正常',
  degraded: isEn ? 'Degraded' : '延遲',
  down: isEn ? 'Down' : '中斷',
  disabled: isEn ? 'Disabled' : '已停用',
};

const opsRoutineItems = opsStatus?.routines?.items ?? [];
const opsRoutinesShown = opsRoutineItems.filter((r) => r.enabled);
const opsRoutinesDisabled = opsRoutineItems.filter((r) => !r.enabled);
const opsStaleHours = opsStatus?.routines?.stale_hours ?? null;
const opsBabel = opsStatus?.babel ?? null;
const opsBabelNodes = (opsBabel?.nodes ?? []).map((n) => ({
  ...n,
  isEndpoint: typeof n.alive === 'boolean',
}));
const opsIncidents = opsStatus?.incidents ?? [];
const opsDeploys = opsStatus?.deploys ?? null;
---

<Layout
  lang={lang}
  title={t('dashboard.meta.title')}
  description={t('dashboard.meta.description')}
  readerSettings={true}
>
  <main class="dashboard">
    <!-- Hero -->
    <!--
      Phase 7.5 partial migration — dashboard.template.astro
      Hero section moved to inline Tailwind. `.ekg-line` + its
      @keyframes ekgDraw animation stay scoped (the animation can't
      be reached via Tailwind arbitrary utilities without promoting
      the keyframes to global.css — too small a win to justify).
      Inner sections (vitals-grid, dashboard cards, organism
      anatomy, etc.) remain scoped — ~170 classes with tight JS
      coupling.
    -->
    <!--
      Dashboard hero is a structural outlier: a rounded-card gradient
      shell with an animated EKG SVG background and a JS-updated stats
      row. PageHero can't absorb the shell (would need `bgShape=rounded`
      + `<slot name=background>` + new stats slot for one consumer), so
      we NEST PageHero inside the custom shell to handle the standard
      title/subtitle/footer axis, and keep the EKG + stats as custom
      siblings. Partial migration: structural consistency for the
      "this page has a title" part, custom code only where it's truly
      unique.
    -->
    <section
      class="page-hero-dashboard-shell relative mb-4 overflow-hidden rounded-2xl bg-[linear-gradient(135deg,#1a1a2e_0%,#2d1b69_60%,#1a1a2e_100%)] text-white"
    >
      <svg
        class="pointer-events-none absolute left-0 top-1/2 h-[60px] w-full -translate-y-1/2 opacity-60"
        viewBox="0 0 600 60"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="ekg-line"
          d="M0,30 L120,30 L140,30 L155,8 L165,52 L175,20 L185,38 L195,30 L280,30 L300,30 L315,8 L325,52 L335,20 L345,38 L355,30 L440,30 L460,30 L475,8 L485,52 L495,20 L505,38 L515,30 L600,30"
          fill="none"
          stroke="rgba(139,92,246,0.25)"
          stroke-width="2"></path>
      </svg>
      <PageHero
        containerWidth="full"
        padding="compact"
        bgTone="dark"
        titleVariant="inherit"
        titleWeight="bold"
        titleSize="sm"
      >
        <Fragment slot="title">
          <span class="relative text-[1.8rem]">🔬</span>
          <span class="relative">{t('dashboard.hero.title')}</span>
        </Fragment>
        <Fragment slot="subtitle">{t('dashboard.hero.subtitle')}</Fragment>
        <Fragment slot="meta">{t('dashboard.hero.description')}</Fragment>
        <Fragment slot="footer">
          <a
            href="https://github.com/frank890417/taiwan-md/tree/main/docs/semiont"
            target="_blank"
            rel="noopener"
            class="inline-block text-[0.85rem] text-[#94a3b8] no-underline opacity-80 transition-opacity duration-200 hover:text-[#cbd5e1] hover:opacity-100"
          >
            {
              isEn
                ? '→ Cognitive Layer (Self-Awareness System)'
                : '→ 前往認知層（自我覺察系統）'
            }
          </a>
        </Fragment>
      </PageHero>
      <div
        class="relative mb-8 flex justify-center gap-12 max-[768px]:gap-6"
        id="hero-stats"
      >
        <div class="flex flex-col items-center">
          <span
            class="text-[2.8rem] font-black leading-[1.1] [font-variant-numeric:tabular-nums]"
            id="hero-stat-articles">—</span
          >
          <span
            class="mt-[0.3rem] text-[0.85rem] uppercase tracking-[0.05em] opacity-70"
            >{isEn ? 'Articles' : '文章'}</span
          >
        </div>
        <div class="flex flex-col items-center">
          <span
            class="text-[2.8rem] font-black leading-[1.1] [font-variant-numeric:tabular-nums]"
            id="hero-stat-languages">—</span
          >
          <span
            class="mt-[0.3rem] text-[0.85rem] uppercase tracking-[0.05em] opacity-70"
            >{isEn ? 'Languages' : '語言'}</span
          >
        </div>
        <div class="flex flex-col items-center">
          <span
            class="text-[2.8rem] font-black leading-[1.1] [font-variant-numeric:tabular-nums]"
            id="hero-stat-contributors">—</span
          >
          <span
            class="mt-[0.3rem] text-[0.85rem] uppercase tracking-[0.05em] opacity-70"
            >{isEn ? 'Contributors' : '貢獻者'}</span
          >
        </div>
      </div>
    </section>

    <!-- Vital Signs -->
    <section class="section" id="vitals">
      <h2 class="section-title">
        {t('dashboard.vitals.title')}
        <span class="section-timestamp" data-source="vitals"></span>
      </h2>
      <div class="vitals-grid" id="vitals-grid">
        <div class="vital-card" data-vital="heartbeat">
          <div class="vital-emoji">💓</div>
          <div class="vital-value" id="vital-heartbeat">—</div>
          <div class="vital-label">{t('dashboard.vitals.heartbeat')}</div>
          <div class="vital-desc">{t('dashboard.vitals.heartbeat.desc')}</div>
        </div>
        <div class="vital-card" data-vital="cells">
          <div class="vital-emoji">🧫</div>
          <div class="vital-value" id="vital-cells">—</div>
          <div class="vital-label">{t('dashboard.vitals.cells')}</div>
          <div class="vital-desc">{t('dashboard.vitals.cells.desc')}</div>
        </div>
        <div class="vital-card" data-vital="immunity">
          <div class="vital-emoji">🛡️</div>
          <div class="vital-value" id="vital-immunity">—</div>
          <div class="vital-label">{t('dashboard.vitals.immunity')}</div>
          <div class="vital-desc">{t('dashboard.vitals.immunity.desc')}</div>
        </div>
        <div class="vital-card" data-vital="dna">
          <div class="vital-emoji">🧬</div>
          <div class="vital-value" id="vital-dna">—</div>
          <div class="vital-label">{t('dashboard.vitals.dna')}</div>
          <div class="vital-desc">{t('dashboard.vitals.dna.desc')}</div>
        </div>
        <div class="vital-card" data-vital="revision">
          <div class="vital-emoji">📐</div>
          <div class="vital-value" id="vital-revision">—</div>
          <div class="vital-label">{t('dashboard.vitals.revision')}</div>
          <div class="vital-desc">{t('dashboard.vitals.revision.desc')}</div>
        </div>
      </div>
    </section>

    <!-- Recent Activity -->
    <section class="section" id="activity">
      <h2 class="section-title">
        {isEn ? '🔔 Recent Activity' : '🔔 最近活動'}
        <span class="section-timestamp" data-source="articles"></span>
      </h2>
      <div class="activity-feed" id="activity-feed"></div>
    </section>

    <!-- Article Registry -->
    <section class="section" id="registry">
      <h2 class="section-title">
        {t('dashboard.registry.title')}
        <span class="section-timestamp" data-source="articles"></span>
      </h2>
      <p class="section-subtitle">{t('dashboard.registry.subtitle')}</p>

      <div class="registry-controls">
        <input
          type="text"
          id="registry-search"
          class="registry-search"
          placeholder={t('dashboard.registry.search')}
        />
        <div class="registry-filters">
          <select id="filter-category" class="registry-filter">
            <option value="">{t('dashboard.registry.filter.all')}</option>
          </select>
          <select id="filter-reviewed" class="registry-filter">
            <option value="">{t('dashboard.registry.filter.reviewed')}</option>
            <option value="true"
              >{t('dashboard.registry.filter.reviewed.yes')}</option
            >
            <option value="false"
              >{t('dashboard.registry.filter.reviewed.no')}</option
            >
          </select>
          <select id="filter-featured" class="registry-filter">
            <option value="">{t('dashboard.registry.filter.featured')}</option>
            <option value="true">⭐</option>
            <option value="false">—</option>
          </select>
          <select id="filter-translation" class="registry-filter">
            <option value=""
              >{t('dashboard.registry.filter.translation')}</option
            >
            <option value="has-en"
              >{t('dashboard.registry.filter.translation.has-en')}</option
            >
            <option value="missing-en"
              >{t('dashboard.registry.filter.translation.missing-en')}</option
            >
          </select>
        </div>
      </div>

      <div class="registry-summary" id="registry-summary"></div>

      <div class="registry-table-controls">
        <button class="column-toggle-btn" id="column-toggle-btn">
          {isEn ? '⚙️ Show all columns' : '⚙️ 顯示所有欄位'}
        </button>
      </div>
      <div class="registry-table-wrapper">
        <table class="registry-table" id="registry-table">
          <thead>
            <tr>
              <th class="sortable" data-sort="title"
                >{t('dashboard.registry.col.title')}</th
              >
              <th class="sortable" data-sort="category"
                >{t('dashboard.registry.col.category')}</th
              >
              <th class="sortable" data-sort="subcategory"
                >{isEn ? 'Subcategory' : '子分類'}</th
              >
              <th class="sortable" data-sort="date"
                >{t('dashboard.registry.col.date')}</th
              >
              <th class="sortable" data-sort="lastModified"
                >{isEn ? 'Modified' : '最後修改'}</th
              >
              <th class="sortable" data-sort="qualityScore"
                >{isEn ? 'Quality' : '品質'}</th
              >
              <th class="sortable" data-sort="formatIssues"
                >{isEn ? 'Format' : '格式'}</th
              >
              <th class="sortable" data-sort="lastHumanReview"
                >{t('dashboard.registry.col.reviewed')}</th
              >
              <th class="sortable" data-sort="wordCount"
                >{t('dashboard.registry.col.words')}</th
              >
              <th class="sortable col-hideable" data-sort="tagCount"
                >{t('dashboard.registry.col.tags')}</th
              >
              <th>{t('dashboard.registry.col.translations')}</th>
              <th class="sortable col-hideable" data-sort="revision"
                >{t('dashboard.registry.col.revisions')}</th
              >
              <th class="col-edit-header"></th>
            </tr>
          </thead>
          <tbody id="registry-body"></tbody>
        </table>
      </div>
    </section>

    <!-- Health Distribution -->
    <section class="section" id="health-distribution">
      <h2 class="section-title">
        {isEn ? '📊 Health Distribution' : '📊 健康分布'}
        <span class="section-timestamp" data-source="articles"></span>
      </h2>
      <p class="section-subtitle">
        {isEn ? 'How healthy are our articles?' : '文章的健康分數分布'}
      </p>
      <div class="health-chart" id="health-chart"></div>
      <p class="health-summary" id="health-summary"></p>
    </section>

    <!-- Organism Anatomy -->
    <section class="section" id="organism">
      <h2 class="section-title">
        {t('dashboard.organism.title')}
        <span class="section-timestamp" data-source="organism"></span>
      </h2>
      <p class="section-subtitle">{t('dashboard.organism.subtitle')}</p>
      <div class="organ-grid" id="organ-grid"></div>
    </section>

    <!-- Translation Coverage -->
    <section class="section" id="translation">
      <h2 class="section-title">
        {t('dashboard.translation.title')}
        <span class="section-timestamp" data-source="translations"></span>
      </h2>
      <p class="section-subtitle">{t('dashboard.translation.subtitle')}</p>
      <div class="translation-bars" id="translation-bars"></div>

      <!-- Legend: 圖說 (2026-05-09 added per observer feedback) -->
      <div
        class="translation-legend"
        aria-label={t('dashboard.translation.legend.aria')}
      >
        <span class="legend-item">
          <span class="legend-dot legend-dot-fresh">●</span>
          <span class="legend-label"
            >{t('dashboard.translation.legend.fresh')}</span
          >
        </span>
        <span class="legend-item">
          <span class="legend-dot legend-dot-stale">●</span>
          <span class="legend-label"
            >{t('dashboard.translation.legend.stale')}</span
          >
        </span>
        <span class="legend-item">
          <span class="legend-dot legend-dot-missing">●</span>
          <span class="legend-label"
            >{t('dashboard.translation.legend.missing')}</span
          >
        </span>
        <span class="legend-item legend-item-divider">
          <span class="legend-format">N/M</span>
          <span class="legend-label"
            >{t('dashboard.translation.legend.format')}</span
          >
        </span>
      </div>

      <div class="translation-matrix-wrapper">
        <table class="translation-matrix" id="translation-matrix">
          <thead id="translation-matrix-head"></thead>
          <tbody id="translation-matrix-body"></tbody>
        </table>
      </div>
    </section>

    <!--
      i18n UI keys coverage（2026-04-25 β7 Phase 3 任務 #9）
      不同於上方 translation section（文章層面翻譯），這裡顯示
      UI 字串（src/i18n/{module}.ts）的各語言 key 覆蓋率。
      Source: /api/dashboard-i18n.json (由 scripts/tools/i18n-coverage-audit.sh 生成)
      Roadmap: reports/i18n-evolution-roadmap-2026-04-25.md Phase 3 #9
    -->
    <section class="section" id="i18n-ui-coverage">
      <h2 class="section-title">
        {isEn ? '🔤 UI Translation Coverage' : '🔤 介面字串翻譯覆蓋率'}
        <span class="section-timestamp" data-source="i18n"></span>
      </h2>
      <p class="section-subtitle">
        {
          isEn
            ? 'How many UI strings (src/i18n/) each language has translated. Differs from article-level translation above.'
            : '各語言在 src/i18n/ 12 module × 介面字串的翻譯覆蓋率。與上方文章層級翻譯不同。'
        }
      </p>
      <div class="translation-bars" id="i18n-bars"></div>
      <div class="translation-matrix-wrapper">
        <table class="translation-matrix" id="i18n-matrix">
          <thead id="i18n-matrix-head"></thead>
          <tbody id="i18n-matrix-body"></tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500" style="margin-top: 1rem;">
        🟢 = full / 🟡 = partial / 🔴 = missing (FALLBACK_CHAIN active) / — = no
        such module · Re-generate:
        <code
          >bash scripts/tools/i18n-coverage-audit.sh --json-out
          public/api/dashboard-i18n.json</code
        >
        · Roadmap:
        <a
          href="https://github.com/frank890417/taiwan-md/blob/main/reports/i18n-evolution-roadmap-2026-04-25.md"
          >reports/i18n-evolution-roadmap-2026-04-25.md</a
        >
      </p>
    </section>

    <!-- Immune System -->
    <section class="section" id="immune">
      <h2 class="section-title">
        {t('dashboard.immune.title')}
        <span class="section-timestamp" data-source="articles"></span>
      </h2>
      <p class="section-subtitle">{t('dashboard.immune.subtitle')}</p>

      <div class="immune-overview" id="immune-overview"></div>

      <h3 class="subsection-title">{t('dashboard.immune.defense.title')}</h3>
      <div class="defense-lines">
        <div class="defense-line">
          <span class="defense-status active">🟢</span>
          <strong>{t('dashboard.immune.defense.line1')}</strong>
          <span class="defense-desc"
            >{t('dashboard.immune.defense.line1.desc')}</span
          >
        </div>
        <div class="defense-line">
          <span class="defense-status active">🟢</span>
          <strong>{t('dashboard.immune.defense.line2')}</strong>
          <span class="defense-desc"
            >{t('dashboard.immune.defense.line2.desc')}</span
          >
        </div>
        <div class="defense-line">
          <span class="defense-status manual">🟡</span>
          <strong>{t('dashboard.immune.defense.line3')}</strong>
          <span class="defense-desc"
            >{t('dashboard.immune.defense.line3.desc')}</span
          >
        </div>
        <div class="defense-line">
          <span class="defense-status active">🟢</span>
          <strong>{t('dashboard.immune.defense.line4')}</strong>
          <span class="defense-desc"
            >{t('dashboard.immune.defense.line4.desc')}</span
          >
        </div>
      </div>

      <h3 class="subsection-title">
        {isEn ? '📋 Citation Health' : '📋 引用健康度'}
      </h3>
      <p class="queue-desc">
        {isEn ? 'How verifiable is the knowledge?' : '知識的可驗證性'}
      </p>
      <div class="citation-health" id="citation-health"></div>

      <h3 class="subsection-title">{t('dashboard.immune.queue.title')}</h3>
      <p class="queue-desc">{t('dashboard.immune.queue.desc')}</p>
      <div class="immune-queue" id="immune-queue"></div>
    </section>

    <!-- Reproduction System — Spores & Amplification (2026-04-18 δ-late) -->
    <section class="section" id="spores">
      <h2 class="section-title">
        {isEn ? '🌱 Reproduction — Spores & Reach' : '🌱 繁殖系統 — 孢子與成效'}
        <span class="section-timestamp" data-source="spores"></span>
      </h2>
      <p class="section-subtitle">
        {
          isEn
            ? 'How Taiwan.md content travels beyond the website'
            : '孢子怎麼把 Taiwan.md 的內容散出去'
        }
      </p>

      <div class="spores-overview" id="spores-overview"></div>

      <h3 class="subsection-title">
        {isEn ? '🔥 Top Performers' : '🔥 成效排行'}
      </h3>
      <div class="spores-top" id="spores-top"></div>

      <h3 class="subsection-title">
        {isEn ? '📈 GA Amplification' : '📈 GA 放大倍數'}
      </h3>
      <p class="queue-desc">
        {
          isEn
            ? 'How much did spores boost article traffic vs baseline?'
            : '孢子讓文章流量相對基線放大多少倍？'
        }
      </p>
      <div class="spores-amplification" id="spores-amplification"></div>

      <h3 class="subsection-title">
        {isEn ? '🆚 Platform Comparison' : '🆚 平台對比'}
      </h3>
      <div class="spores-platforms" id="spores-platforms"></div>

      <h3 class="subsection-title">
        {isEn ? '🚨 Backfill Status' : '🚨 回填狀態'}
      </h3>
      <p class="queue-desc">
        {
          isEn
            ? 'Spores published ≥7 days ago without metrics = OVERDUE'
            : '發布 ≥7 天沒回填指標 = OVERDUE，下一則孢子不准發'
        }
      </p>
      <div class="spores-backfill" id="spores-backfill"></div>

      <h3 class="subsection-title">
        {isEn ? '📅 Weekly Pulse' : '📅 週節律'}
      </h3>
      <div class="spores-weekly" id="spores-weekly"></div>
    </section>

    <!-- Contribution Leaderboard — Top Contributors (2026-04-19 β) -->
    <section class="section" id="contributors">
      <h2 class="section-title">
        {isEn ? '👥 Contribution Leaderboard' : '👥 貢獻者排行榜'}
        <span class="section-timestamp" data-source="contributors"></span>
      </h2>
      <p class="section-subtitle">
        {
          isEn
            ? 'Top 20 contributors by commits + primary area (content / system / translation)'
            : '依 commits 數排序的前 20 位貢獻者，以及主要貢獻類型（內容 / 系統 / 翻譯）'
        }
      </p>

      <div class="contributors-overview" id="contributors-overview"></div>

      <h3 class="subsection-title">
        {isEn ? '🏆 Top 20 Contributors' : '🏆 前 20 位貢獻者'}
      </h3>
      <div class="contributors-leaderboard" id="contributors-leaderboard"></div>

      <h3 class="subsection-title">
        {isEn ? '📊 By Primary Area' : '📊 依主要貢獻領域'}
      </h3>
      <div class="contributors-areas" id="contributors-areas"></div>

      <h3 class="subsection-title">
        {isEn ? '🌱 Recently Joined' : '🌱 最近加入'}
      </h3>
      <p class="section-subtitle" style="margin-top:-8px">
        {
          isEn
            ? 'First-time contributors in the last 30 days'
            : '過去 30 天第一次貢獻的小丑魚'
        }
      </p>
      <div class="contributors-recent" id="contributors-recent"></div>
    </section>

    <!-- Growth Timeline -->
    <section class="section" id="growth">
      <h2 class="section-title">
        {t('dashboard.growth.title')}
        <span class="section-timestamp" data-source="articles"></span>
      </h2>
      <p class="section-subtitle">{t('dashboard.growth.subtitle')}</p>
      <div class="growth-chart" id="growth-chart"></div>
    </section>

    <!-- Content Analysis -->
    <section class="section" id="content-analysis">
      <h2 class="section-title">
        {isEn ? '📊 Content Analysis' : '📊 內容成長分析'}
        <span class="section-timestamp" data-source="articles"></span>
      </h2>
      <p class="section-subtitle">
        {
          isEn
            ? 'Article distribution across categories'
            : '各分類文章分布與成長軌跡'
        }
      </p>
      <div class="content-analysis-grid">
        <div class="ca-chart" id="ca-category-chart"></div>
        <div class="ca-stats" id="ca-stats"></div>
      </div>
    </section>

    <!--
      Operational Status — 🩺 status.claude.com 式營運狀態 (2026-07-24)
      唯一 SSG build-time 烘進 HTML 的 section，零 client JS：uptime 網格
      是純 CSS grid，讀者不用等 JS fetch 才看得到 routine 飛輪死活。
      Source: public/api/dashboard-status.json
      Generator: scripts/core/generate-dashboard-status.mjs
      Design report: reports/design-dashboard-status-section-2026-07-24.md
    -->
    <section class="section" id="ops-status">
      <h2 class="section-title">
        {isEn ? '🩺 Operational Status' : '🩺 營運狀態'}
      </h2>
      <p class="section-subtitle">
        {
          isEn
            ? "Is this organism's automation alive right now — routine flywheel, babel translation infra, recent incidents."
            : '這個生命體的自動化器官現在活著嗎——routine 飛輪、巴別塔翻譯基建、最近事件。'
        }
      </p>

      {
        opsStaleHours !== null && opsStaleHours > 48 && (
          <p class="ops-stale-note">
            {isEn
              ? `⚠️ Routine snapshot is ${opsStaleHours}h old — data-refresh rider hasn't run`
              : `⚠️ 排程快照齡 ${opsStaleHours}h — data-refresh rider 未跑`}
          </p>
        )
      }

      <!-- Routine 飛輪狀態列 -->
      <h3 class="subsection-title">
        {isEn ? '🔁 Routine Flywheel' : '🔁 Routine 飛輪'}
      </h3>
      {
        opsStatus?.routines ? (
          <>
            <div class="ops-routine-list">
              {opsRoutinesShown.map((r) => (
                <div class="ops-routine-row">
                  <span
                    class={`ops-dot ops-dot-${r.status}`}
                    title={OPS_STATUS_LABEL[r.status]}
                  />
                  <span class="ops-routine-id">{r.id}</span>
                  <span class="ops-routine-cadence">{r.cadence_human}</span>
                  <span class="ops-routine-lastfire">
                    {opsRelTime(r.last_fire)}
                  </span>
                  <span class="ops-grid14">
                    {r.grid14.map((c) => (
                      <span
                        class={`ops-cell ops-cell-${c.state}`}
                        title={`${c.date} · ${c.state}`}
                      />
                    ))}
                  </span>
                </div>
              ))}
            </div>
            {opsRoutinesDisabled.length > 0 && (
              <p class="ops-disabled-note">
                {isEn ? 'Disabled: ' : '已停用：'}
                {opsRoutinesDisabled.map((r) => r.id).join(isEn ? ', ' : '、')}
              </p>
            )}
          </>
        ) : (
          <p class="ops-empty">
            {isEn
              ? 'Routine data unavailable this build.'
              : '這次 build 沒有 routine 資料。'}
          </p>
        )
      }

      <!-- 巴別塔覆蓋 -->
      <h3 class="subsection-title">
        {isEn ? '🌐 Babel Coverage' : '🌐 巴別塔覆蓋'}
      </h3>
      {
        opsBabel ? (
          <>
            <div class="ops-babel-bars">
              {opsBabel.langs.map((l) => (
                <div class="ops-babel-row">
                  <span class="ops-babel-lang">
                    {LANGUAGE_DISPLAY_NAMES[l.lang] || l.lang}
                  </span>
                  <span class="ops-bar-track">
                    <span
                      class="ops-bar-fresh"
                      style={`width:${((l.fresh / opsBabel.total_zh) * 100).toFixed(1)}%`}
                    />
                    <span
                      class="ops-bar-stale"
                      style={`width:${((l.stale / opsBabel.total_zh) * 100).toFixed(1)}%`}
                    />
                  </span>
                  <span class="ops-babel-pct">{l.coverage_pct}%</span>
                </div>
              ))}
            </div>
            <p class="ops-babel-summary">
              {isEn
                ? `Gap total ${opsBabel.gap_total} (${opsGapArrow(opsBabel.gap_delta_vs_prev)} vs prev snapshot) · fresh +${opsBabel.fresh_delta_24h} in 24h`
                : `總缺口 ${opsBabel.gap_total}（${opsGapArrow(opsBabel.gap_delta_vs_prev)} vs 上一快照）· 近 24h fresh +${opsBabel.fresh_delta_24h}`}
            </p>
            <div class="ops-babel-nodes">
              {opsBabelNodes.map((n) => (
                <span class="ops-node">
                  {n.isEndpoint ? (
                    <span
                      class={`ops-node-dot ${n.alive ? 'ops-node-alive' : 'ops-node-dead'}`}
                    />
                  ) : (
                    <span class="ops-node-counts">
                      {n.ok}✓ {n.fail}✗
                    </span>
                  )}
                  <span class="ops-node-name">{n.name}</span>
                </span>
              ))}
            </div>
          </>
        ) : (
          <p class="ops-empty">
            {isEn
              ? 'Babel data unavailable this build.'
              : '這次 build 沒有巴別塔資料。'}
          </p>
        )
      }

      <!-- 最近事件 -->
      <h3 class="subsection-title">
        {isEn ? '🚨 Recent Incidents' : '🚨 最近事件'}
      </h3>
      <div class="ops-incidents">
        {
          opsIncidents.length === 0 ? (
            <p class="ops-empty">
              {isEn ? 'No active incidents.' : '目前沒有事件。'}
            </p>
          ) : (
            opsIncidents.map((inc) => (
              <div class="ops-incident-row">
                <span
                  class={`ops-dot ops-dot-${inc.level === 'red' ? 'down' : 'degraded'}`}
                />
                <span class="ops-incident-text">{inc.text}</span>
                <span class="ops-incident-ts">{inc.ts}</span>
              </div>
            ))
          )
        }
      </div>
      {
        opsDeploys && opsDeploys.length > 0 && (
          <>
            <h3 class="subsection-title">
              {isEn ? '🚀 Recent Deploys' : '🚀 最近部署'}
            </h3>
            <div class="ops-deploys">
              {opsDeploys.map((d) => (
                <div class="ops-deploy-row">
                  <span
                    class={`ops-dot ${d.conclusion === 'success' ? 'ops-dot-operational' : 'ops-dot-down'}`}
                  />
                  <span class="ops-deploy-title">{d.title}</span>
                  <span class="ops-deploy-ts">{opsRelTime(d.ts)}</span>
                </div>
              ))}
            </div>
          </>
        )
      }
    </section>

    <!-- GA4 Analytics -->
    <section class="section" id="analytics">
      <h2 class="section-title">
        {isEn ? '📡 Live Pulse' : '📡 即時脈搏'}
        <span class="section-timestamp" data-source="analytics"></span>
      </h2>
      <p class="section-subtitle">
        {
          isEn
            ? 'GA behavior + Search intent + Cloudflare edge signals'
            : 'GA 行為 + 搜尋意圖 + Cloudflare 邊緣訊號'
        }
      </p>
      <div class="analytics-grid">
        <div class="analytics-totals" id="analytics-totals"></div>
        <div class="analytics-sources" id="analytics-insights"></div>
      </div>
      <div class="analytics-detail-grid">
        <div class="analytics-pages analytics-full" id="analytics-pages"></div>
        <div class="analytics-pages analytics-full" id="analytics-articles-7d">
        </div>
        <div class="analytics-pages analytics-full" id="analytics-search"></div>
        <div class="analytics-pages" id="analytics-crawlers"></div>
        <div class="analytics-countries" id="analytics-countries"></div>
      </div>
    </section>

    <!-- Supporters / 贊助時間軸 -->
    <section class="section" id="supporters">
      <SupporterTimeline />
    </section>

    <!-- Next Steps -->
    <section class="section" id="next-steps">
      <h2 class="section-title">{isEn ? '🎯 Next Steps' : '🎯 下一步'}</h2>
      <p class="section-subtitle">
        {isEn ? 'Highest-impact contributions right now' : '現在最有價值的貢獻'}
      </p>
      <div class="nextsteps-grid" id="nextsteps-grid"></div>
    </section>

    <!-- Footer timestamp -->
    <footer class="dashboard-footer" id="dashboard-footer"></footer>
  </main>
</Layout>

<!-- d3 + d3-cloud for Search Console word cloud layout (loaded globally as UMD,
     attach to window.d3 and window.d3.layout.cloud). is:inline keeps Astro from
     bundling. Use defer to not block first paint; renderAnalytics waits on d3
     before drawing the cloud. -->
<script
  is:inline
  defer
  src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script
  is:inline
  defer
  src="https://cdn.jsdelivr.net/npm/d3-cloud@1.2.7/build/d3.layout.cloud.min.js"
></script>

<!-- Dashboard client 渲染邏輯（2,729 行）在 src/scripts/dashboard-client.js —
     2026-06-13 抽出：原 define:vars inline 每語言頁各內嵌一份；改 Astro processed
     module 後 6 頁共用一份 hashed bundle + 瀏覽器可快取。lang 改讀 <html lang>。-->
<script>
  import '../scripts/dashboard-client.js';
</script>
