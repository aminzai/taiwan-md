  <script>
    // 漸進增強：1) 子導覽量 header 底緣＋scroll-spy；2) 指標分類篩選（沒有 JS 時篩選列隱藏、全部卡片照常顯示）
    const subnav = document.getElementById('dh-subnav');
    if (subnav) {
      const measure = () => {
        const hc = document.getElementById('header-container');
        const b = hc ? hc.getBoundingClientRect().bottom : 56;
        document.documentElement.style.setProperty(
          '--dh-sticky-top',
          `${Math.max(0, Math.round(b))}px`,
        );
      };
      measure();
      window.addEventListener('resize', measure, { passive: true });
      setTimeout(measure, 800);
      const links = Array.from(
        subnav.querySelectorAll<HTMLAnchorElement>('a[data-target]'),
      );
      const sections = links
        .map((a) => document.getElementById(a.dataset.target!))
        .filter((s): s is HTMLElement => !!s);
      const setActive = (id: string) => {
        links.forEach((a) =>
          a.classList.toggle('is-active', a.dataset.target === id),
        );
        const a = links.find((l) => l.dataset.target === id);
        if (a && subnav.scrollWidth > subnav.clientWidth)
          a.scrollIntoView({
            block: 'nearest',
            inline: 'center',
            behavior: 'smooth',
          });
      };
      if ('IntersectionObserver' in window) {
        // 只看視窗中線：區塊很長時 intersectionRatio 一直很小，用比例挑會卡在第一區
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) setActive((e.target as HTMLElement).id);
            });
          },
          { rootMargin: '-45% 0px -54% 0px', threshold: 0 },
        );
        sections.forEach((s) => io.observe(s));
      }
    }

    const filter = document.getElementById('dh-filter');
    if (filter) {
      filter.hidden = false;
      const buttons = Array.from(
        filter.querySelectorAll<HTMLButtonElement>('button[data-filter]'),
      );
      const groups = Array.from(
        document.querySelectorAll<HTMLElement>('.dh-group[data-group]'),
      );
      buttons.forEach((btn) =>
        btn.addEventListener('click', () => {
          const key = btn.dataset.filter!;
          buttons.forEach((b) =>
            b.setAttribute('aria-pressed', String(b === btn)),
          );
          groups.forEach(
            (g) => (g.hidden = key !== 'all' && g.dataset.group !== key),
          );
        }),
      );
      // 從別處點進某張卡（#ind-xxx）時，確保它所在的分組是開的
      const reveal = () => {
        const id = location.hash.slice(1);
        if (!id.startsWith('ind-')) return;
        const card = document.getElementById(id);
        const g = card?.closest<HTMLElement>('.dh-group');
        if (g?.hidden) {
          groups.forEach((x) => (x.hidden = false));
          buttons.forEach((b) =>
            b.setAttribute('aria-pressed', String(b.dataset.filter === 'all')),
          );
          card?.scrollIntoView();
        }
      };
      window.addEventListener('hashchange', reveal);
    }
  </script>
