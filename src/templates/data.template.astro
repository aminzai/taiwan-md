                  </figcaption>
                </figure>
              ))}
            </div>
          )
        }
        <div class="dh-chart-index">
          {
            chartGroups.map((g) => (
              <section
                class="dh-chart-cat"
                style={`--dh-cat:${catColor(g.cat)}`}
